<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Luts\BlueArchitecture.cube" />
    <EmbeddedResource Include="Assets\Luts\ColdChrome.cube" />
    <EmbeddedResource Include="Assets\Luts\CrispAutumn.cube" />
    <EmbeddedResource Include="Assets\Luts\DarkAndSomber.cube" />
    <EmbeddedResource Include="Assets\Luts\Earth.cube" />
    <EmbeddedResource Include="Assets\Luts\GrainyFilm.cube" />
    <EmbeddedResource Include="Assets\Luts\Kodachrome.cube" />
    <EmbeddedResource Include="Assets\Luts\LongBeachMorning.cube" />
    <EmbeddedResource Include="Assets\Luts\MagicHour.cube" />
    <EmbeddedResource Include="Assets\Luts\PastelMorning.cube" />
    <EmbeddedResource Include="Assets\Luts\Waves.cube" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nullable.Extended.Analyzer" Version="1.16.6891">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Openize.HEIC" Version="26.5.0" />
    <PackageReference Include="Sdcb.LibRaw" Version="0.21.1.7" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.1" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="3.1.0" />
  </ItemGroup>
  
  <PropertyGroup>
    <SixLaborsLicenseFile>..\..\Licences\sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Lyt.Framework\Lyt.Collections\Lyt.Collections.csproj" />
    <ProjectReference Include="..\..\Lyt.Framework\Lyt.Persistence\Lyt.Persistence.csproj" />
    <ProjectReference Include="..\..\Lyt.Framework\Lyt.Resources\Lyt.Resources.csproj" />
    <ProjectReference Include="..\..\Lyt.Framework\Lyt.Utilities\Lyt.Utilities.csproj" />
    <ProjectReference Include="..\Lyt.PhotoPostPro.MultiPlatformAbstractions\Lyt.PhotoPostPro.MultiPlatformAbstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="libraw.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
