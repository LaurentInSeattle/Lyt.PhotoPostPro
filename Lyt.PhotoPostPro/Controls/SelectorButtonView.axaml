<UserControl 
	x:Class="Lyt.PhotoPostPro.Controls.SelectorButtonView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Controls"
	x:DataType="vm:SelectorButtonViewModel" 

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"
	>
	<Grid		
		Height="{Binding ButtonHeight}"
		ClipToBounds="False"
		>
		<Grid.RowDefinitions> 
			<RowDefinition Height="{Binding RowHeight}" />
			<RowDefinition Height="6" />
		</Grid.RowDefinitions>
		<glyphs:GlyphButton
			x:Name="NavigationButton"
			Style="{StaticResource NavigationButton}"
			Text="{Binding ButtonText}"
			Command="{Binding OnSelect}" 
			Width="{Binding ButtonWidth}"
			Height="{Binding ButtonHeight}"
			Margin="2"
			FontSize="{Binding ButtonFontSize}"
			/>
		<Rectangle
			x:Name="NavigationIndicator"
			Grid.Column="1"
			IsVisible="False"
			Grid.Row="1"
			Margin="2 0 2 0"
			Height="3" 
			HorizontalAlignment="Stretch" VerticalAlignment="Center"
			Fill="{StaticResource FreshGreen_2_100}"
			/>
		<Rectangle
			Grid.Row="0"
			IsVisible="{Binding IsConnectedLeft}"
			Fill="{StaticResource FreshGreen_2_100}"
			Margin="-10 0 0 0"
			Height="2" Width="10"
			HorizontalAlignment="Left" VerticalAlignment="Center"
			/>
		<Rectangle
			Grid.Row="0"
			IsVisible="{Binding IsConnectedRight}"
			Fill="{StaticResource FreshGreen_2_100}"
			Margin="0 0 -10 0"
			Height="2" Width="10"
			HorizontalAlignment="Right" VerticalAlignment="Center"
			/>
	</Grid>

</UserControl>
