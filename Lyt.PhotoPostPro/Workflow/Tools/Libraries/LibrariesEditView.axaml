<UserControl 
	x:Class="Lyt.PhotoPostPro.Workflow.Tools.Libraries.LibrariesEditView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Tools.Libraries"
	x:DataType="vm:LibrariesEditViewModel" 
	
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	Background="Transparent"
	>
	<Grid	
		ShowGridLines="False"
		> 
		<Grid.RowDefinitions>
			<RowDefinition Height="4" />
			<RowDefinition Height="54" /> <!-- Friendly Name -->
			<RowDefinition Height="90" /> <!-- Description -->
			<RowDefinition Height="54" /> <!-- Button for Path -->
			<RowDefinition Height="54" /> <!-- Path -->
			<RowDefinition Height="60" /> <!-- Validation -->
			<RowDefinition Height="4" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="8" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="420" />
			<ColumnDefinition Width="8" />
		</Grid.ColumnDefinitions>

		<TextBlock
			Grid.Column="1" Grid.Row="1" 
			Theme="{StaticResource Medium}"
			Text="{DynamicResource Tools.Editor.FriendlyNamePrompt}"
			TextAlignment="Right"
			VerticalAlignment="Center" HorizontalAlignment="Right"
			/>
		<TextBox
			x:Name="FriendlyNameTextBox"
			Grid.Column="2" Grid.Row="1" 
			VerticalContentAlignment="Center" 
			VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
			Width="360" Height="40"
			MaxLength="40"
			Text="{Binding FriendlyName}"
			IsEnabled="{Binding FriendlyNameIsEnabled}"
			/>
		<TextBlock
			Grid.Column="1" Grid.Row="2" 
			Theme="{StaticResource Medium}"
			Text="{DynamicResource Tools.Editor.DescriptionPrompt}"
			TextAlignment="Right"
			VerticalAlignment="Center" HorizontalAlignment="Right"
			/>
		<TextBox
			x:Name="TextTextBox"
			Grid.Column="2" Grid.Row="2" 
			VerticalContentAlignment="Center" 
			VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
			Width="360" Height="80"
			MaxLength="60"
			Text="{Binding Description}"
			Margin="0"
			AcceptsReturn="True"
			/>

		<TextBlock
			Grid.Column="1" Grid.Row="4" 
			Theme="{StaticResource Medium}"
			Text="{DynamicResource Tools.Editor.DescriptionPrompt}"
			TextAlignment="Right"
			VerticalAlignment="Center" HorizontalAlignment="Right"
			/>
		<TextBox
			x:Name="PathTextBox"
			Grid.Column="2" Grid.Row="4" 
			IsReadOnly="True"
			VerticalContentAlignment="Center" 
			VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
			Width="360" Height="80"
			MaxLength="60"
			Text="{Binding FolderPath}"
			Margin="0"
			AcceptsReturn="True"
			/>

		<TextBlock
			Grid.Row="12"  Grid.Column="1" Grid.ColumnSpan="2" 
			Text="{Binding ValidationMessage}"
			Theme="{StaticResource ValidationError}"
			TextAlignment="Center"
			VerticalAlignment="Center" HorizontalAlignment="Center"
			/>
	</Grid>
</UserControl>
