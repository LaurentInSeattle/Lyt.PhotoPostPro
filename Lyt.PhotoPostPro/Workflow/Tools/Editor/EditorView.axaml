<UserControl 
	x:Class="Lyt.PhotoPostPro.Workflow.Tools.Editor.EditorView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Tools.Editor"
	x:DataType="vm:EditorViewModel" 
	
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:controls="clr-namespace:Lyt.PhotoPostPro.Controls"
	xmlns:images="clr-namespace:Lyt.Avalonia.Controls.Images;assembly=Lyt.Avalonia.Controls"
	xmlns:shared="clr-namespace:Lyt.PhotoPostPro.Workflow.Shared"
	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"
	xmlns:meta="clr-namespace:Lyt.PhotoPostPro.Panes.MetadataPane"

	Background="Transparent"
	>
	<Grid	
		> 
		<Grid.RowDefinitions>
			<RowDefinition Height="4" />
			<RowDefinition Height="64" />
			<RowDefinition Height="Auto" MinHeight="120" />
			<RowDefinition Height="64" />
			<RowDefinition Height="*" />
			<RowDefinition Height="4" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="8" />
			<ColumnDefinition Width="300" />
			<ColumnDefinition Width="8" />
			<ColumnDefinition Width="680" />
			<ColumnDefinition Width="8" />
		</Grid.ColumnDefinitions>
		<Rectangle
			Grid.Row="0" Grid.Column="0"
			Grid.RowSpan="99" Grid.ColumnSpan="99"
			Fill="#B0000020"
			/>

		<!-- List box of editable objects on the left side --> 
		<ListBox
			x:Name="StripListBox"
			Grid.Row="1" Grid.RowSpan="3" Grid.Column="1"
			ItemsSource="{Binding EditableObjects}"
			SelectedIndex="{Binding SelectedObjectIndex, Mode=TwoWay}"
			SelectionMode="Single"
			ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			> 
			<ListBox.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel 
						Background="Transparent"
						Orientation="Vertical" 
						/>
				</ItemsPanelTemplate>
			</ListBox.ItemsPanel>
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Grid
						Width="200" Height="40"
						> 
						<TextBlock 
							Theme="{StaticResource H3}"
							Text="{Binding FriendlyName}" 
							Margin="4 0 24 0"
							HorizontalAlignment="Center" VerticalAlignment="Center"
							Foreground="{StaticResource LightAqua_0_100}"
							/>
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<!-- Editing form on the right side --> 
		<TextBlock 
			Grid.Row="1" Grid.Column="3"
			Margin="4 0 4 0"
			Theme="{StaticResource H2}"
			Text="{Binding FriendlyName}" 
			HorizontalAlignment="Center" VerticalAlignment="Center"
			TextAlignment="Center"
			Foreground="{StaticResource LightAqua_0_100}"
			/>
		<ContentControl 
			Grid.Row="2" Grid.Column="3"
			Content="{Binding EditingForm}"
			/>
		<glyphs:GlyphButton
			x:Name="DeleteButton"
			Grid.Row="3" Grid.Column="3"
			IsVisible="{Binding IsEditMode}"
			Style="{StaticResource ViewIconButton}"
			FontSize="24"
			HorizontalAlignment="Left" VerticalAlignment="Center"
			Width="300" Height="56"
			Margin="4"
			GlyphSource="delete"
			ButtonBackground="BorderlessRectangle"
			GlyphStrokeThickness="0"
			Text="{DynamicResource Tools.Editor.Delete}"
			Command="{Binding OnDelete}"
	    	/>
		<glyphs:GlyphButton
			x:Name="SaveButton"
			Grid.Row="3" Grid.Column="3"
			IsVisible="{Binding IsEditMode}"
			Style="{StaticResource ViewIconButton}"
			FontSize="24"
			HorizontalAlignment="Right" VerticalAlignment="Center"
			Width="300" Height="56"
			Margin="4"
			GlyphSource="save"
			ButtonBackground="BorderlessRectangle"
			GlyphStrokeThickness="0"
			Text="{DynamicResource Tools.Editor.Save}"
			Command="{Binding OnSave}"
	    	/>
		<glyphs:GlyphButton
			x:Name="AddButton"
			Grid.Row="3" Grid.Column="3"
			IsVisible="{Binding IsAddMode}"
			Style="{StaticResource ViewIconButton}"
			FontSize="24"
			HorizontalAlignment="Right" VerticalAlignment="Center"
			Width="300" Height="56"
			Margin="4"
			GlyphSource="add_circle"
			ButtonBackground="BorderlessRectangle"
			GlyphStrokeThickness="0"
			Text="{DynamicResource Tools.Editor.Add}"
			Command="{Binding OnAdd}"
	    	/>
	</Grid>
</UserControl>
