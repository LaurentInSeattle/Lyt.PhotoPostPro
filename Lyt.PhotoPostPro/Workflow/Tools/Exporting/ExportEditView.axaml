<UserControl 
	x:Class="Lyt.PhotoPostPro.Workflow.Tools.Exporting.ExportEditView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Tools.Exporting"
	x:DataType="vm:ExportEditViewModel" 
	
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:edit="clr-namespace:Lyt.PhotoPostPro.Workflow.Tools.Editor"

	Background="Transparent"
	>
	<Grid	
		ShowGridLines="True"
		> 
		<Grid.RowDefinitions>
			<RowDefinition Height="4" />
			<RowDefinition Height="60" /> <!-- Friendly Name -->
			<RowDefinition Height="100" /> <!-- Description -->
			<RowDefinition Height="80" />
			<RowDefinition Height="80" />
			<RowDefinition Height="4" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="8" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="420" />
			<ColumnDefinition Width="8" />
		</Grid.ColumnDefinitions>

		<TextBlock
			Grid.Column="1" Grid.Row="1" 
			Theme="{StaticResource Medium}"
			Text="{DynamicResource Tools.Editor.FriendlyNamePrompt}"
			TextAlignment="Right"
			VerticalAlignment="Center" HorizontalAlignment="Right"
			/>
		<TextBox
			x:Name="FriendlyNameTextBox"
			Grid.Column="2" Grid.Row="1" 
			VerticalContentAlignment="Center" 
			VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
			Width="360" Height="40"
			MaxLength="40"
			Text="{Binding FriendlyName}"
			/>
		<TextBlock
			Grid.Column="1" Grid.Row="2" 
			Theme="{StaticResource Medium}"
			Text="{DynamicResource Tools.Editor.TextPrompt}"
			TextAlignment="Right"
			VerticalAlignment="Center" HorizontalAlignment="Right"
			/>
		<TextBox
			x:Name="TextTextBox"
			Grid.Column="2" Grid.Row="2" 
			VerticalContentAlignment="Center" 
			VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
			Width="360" Height="80"
			MaxLength="60"
			Text="{Binding Description}"
			Margin="0"
			AcceptsReturn="True"
			/>

	</Grid>
</UserControl>
