<UserControl
	x:Class="Lyt.PhotoPostPro.Workflow.Book.Edit.BookDoublePageView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Book.Edit"
	x:DataType="vm:BookDoublePageViewModel"

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	Background="Transparent"
	>
	<Grid >
		<Viewbox Margin="2" >
			<Grid
				Width="{Binding DoublePageWidth}" Height="{Binding PageHeight}"
				>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="{Binding PageWidth}" /> 
					<ColumnDefinition Width="{Binding SeparatorWidth}" />
					<ColumnDefinition Width="{Binding PageWidth}" /> 
				</Grid.ColumnDefinitions>
				<vm:BookPageView
					Grid.Row="0" Grid.Column="0"
					DataContext="{Binding LeftPage}"
					/>
				<vm:BookPageView
					Grid.Row="0" Grid.Column="2"
					DataContext="{Binding RightPage}"
					/>
			</Grid>
		</Viewbox>
	</Grid>
</UserControl>
