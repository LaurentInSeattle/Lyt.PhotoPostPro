<UserControl
	x:Class="Lyt.PhotoPostPro.Workflow.Book.Edit.BookPageView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Book.Edit"
	x:DataType="vm:BookPageViewModel"

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:images="clr-namespace:Lyt.Avalonia.Controls.Images;assembly=Lyt.Avalonia.Controls"
	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"

	DragDrop.AllowDrop="True"
	>
	<Grid
		x:Name="MainGrid"
		Background="Black"
		Width="{Binding PageWidth}" Height="{Binding PageHeight}" 
		>
		<Canvas 
			IsVisible="{Binding IsDummy}"
			Margin="80"
			Background="#A0000040"
			VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
			>					
		</Canvas>
		<Canvas  
			Width="{Binding PageWidth}" Height="{Binding PageHeight}" 
			IsVisible="{Binding AreVisibleGridLines}"
			PointerPressed="OnCanvasPointerPressed"
			>
			<Canvas.Background
				>
				<VisualBrush 
					TileMode="Tile"
					SourceRect="0,0,50,50"
					DestinationRect="0,0,50,50"
					>
					<VisualBrush.Visual>
						<Path 
							Data="M 50 0 L 0 0 0 50"
							Stroke="DarkGray"
							StrokeThickness="1.5"
							StrokeDashArray="2,4"
							Opacity="0.4"
							/>
					</VisualBrush.Visual>
				</VisualBrush>
			</Canvas.Background>					
		</Canvas>

		<!-- Set the Canvas as the container panel 
			 Bind Canvas.Top and Canvas.Left on the ContentPresenter wrapper 
		-->
		<ItemsControl 
			IsVisible="{Binding !IsDummy}"
			ItemsSource="{Binding Slots}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<Canvas 
						Width="{Binding PageWidth}" Height="{Binding PageHeight}" 
						>
					</Canvas>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.Styles>
				<Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:SlotViewModel">
					<Setter Property="Canvas.Left" Value="{Binding X, Mode=OneWay}" />
					<Setter Property="Canvas.Top" Value="{Binding Y, Mode=OneWay}" />
				</Style>
			</ItemsControl.Styles>

			<ItemsControl.ItemTemplate>
				<DataTemplate> <vm:SlotView /> </DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<Rectangle
			x:Name="BindingArea"
			IsVisible="{Binding IsVisibleBindingArea}"
			Width="40"
			VerticalAlignment="Stretch" 
			HorizontalAlignment="{Binding BindingAreaAlignmentSide}"
			Fill="#808080"
			Opacity="0.3"
			IsHitTestVisible="False"
			/>
		<!-- DropRectangle MUST be made  IsHitTestVisible="False" or else the slots do not gets the clicks --> 
		<Rectangle
			x:Name="DropRectangle"
			Fill="Transparent"
			Stroke="Transparent"
			IsHitTestVisible="False"
			/>
	</Grid>
</UserControl>
