<UserControl
	x:Class="Lyt.PhotoPostPro.Workflow.Book.Edit.BookPageView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Book.Edit"
	x:DataType="vm:BookPageViewModel"

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:images="clr-namespace:Lyt.Avalonia.Controls.Images;assembly=Lyt.Avalonia.Controls"
	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"

	Background="Transparent"
	>
	<Grid
		>
		<Canvas 
			IsVisible="{Binding IsDummy}"
			Width="792" Height="612"
			Background="#A0000040"
			>					
		</Canvas>
		<ItemsControl 
			IsVisible="{Binding !IsDummy}"
			ItemsSource="{Binding Slots}">
			<!-- Set the Canvas as the container panel -->
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<Canvas 
						x:Name="PageCanvas"
						Width="792" Height="612"
						Background="Black"
						/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<!-- Bind Canvas.Top and Canvas.Left on the ContentPresenter wrapper -->
			<ItemsControl.Styles>
				<Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:SlotViewModel">
					<Setter Property="Canvas.Left" Value="{Binding SlotX}" />
					<Setter Property="Canvas.Top" Value="{Binding SlotY}" />
				</Style>
			</ItemsControl.Styles>

			<!-- Define how each item looks -->
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:SlotViewModel">
					<vm:SlotView />
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Grid>
</UserControl>
