<UserControl
	x:Class="Lyt.PhotoPostPro.Workflow.Book.Edit.BookPageView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Book.Edit"
	x:DataType="vm:BookPageViewModel"

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:images="clr-namespace:Lyt.Avalonia.Controls.Images;assembly=Lyt.Avalonia.Controls"
	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"

	>
	<Grid
		x:Name="MainGrid"
		Background="Black"
		>
		<Canvas 
			IsVisible="{Binding IsDummy}"
			Width="640" Height="480"
			Background="#A0000040"
			VerticalAlignment="Center" HorizontalAlignment="Center"
			>					
		</Canvas>
		<Canvas  
			Width="{Binding PageWidth}" Height="{Binding PageHeight}" 
			IsVisible="{Binding AreVisibleGridLines}"
			>
			<Canvas.Background
				>
				<VisualBrush 
					TileMode="Tile"
					SourceRect="0,0,50,50"
					DestinationRect="0,0,50,50"
					>
					<VisualBrush.Visual>
						<Path 
							Data="M 50 0 L 0 0 0 50"
							Stroke="DarkGray"
							StrokeThickness="1.5"
							StrokeDashArray="2,4"
							Opacity="0.4"
							/>
					</VisualBrush.Visual>
				</VisualBrush>
			</Canvas.Background>					
		</Canvas>
		<ItemsControl 
			IsVisible="{Binding !IsDummy}"
			ItemsSource="{Binding Slots}">
			<!-- Set the Canvas as the container panel -->
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<Canvas 
						Width="{Binding PageWidth}" Height="{Binding PageHeight}" 
						>
					</Canvas>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<!-- Bind Canvas.Top and Canvas.Left on the ContentPresenter wrapper -->
			<ItemsControl.Styles>
				<Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:SlotViewModel">
					<Setter Property="Canvas.Left" Value="{Binding SlotX}" />
					<Setter Property="Canvas.Top" Value="{Binding SlotY}" />
				</Style>
			</ItemsControl.Styles>

			<!-- Define how each item looks -->
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:SlotViewModel">
					<vm:SlotView />
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Grid>
</UserControl>
