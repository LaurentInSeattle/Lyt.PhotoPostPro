<UserControl
	x:Class="Lyt.PhotoPostPro.Workflow.Book.Edit.TextStyleView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Book.Edit"
	x:DataType="vm:TextStyleViewModel"

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:images="clr-namespace:Lyt.Avalonia.Controls.Images;assembly=Lyt.Avalonia.Controls"
	xmlns:local="using:Lyt.PhotoPostPro.Workflow.Documentation"
	xmlns:shared="clr-namespace:Lyt.PhotoPostPro.Workflow.Shared"
	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"
	xmlns:meta="clr-namespace:Lyt.PhotoPostPro.Panes.MetadataPane"

	Background="Transparent"
	>
	<Grid
		Width="220" Height="48"
		Background="{Binding PageColor}"
		>
		<TextBlock
			Text="{Binding Text}"
			FontFamily="{Binding FontFamily}"
			FontSize="{Binding FontSize}"
			FontStyle="{Binding FontStyle}"
			Foreground="{Binding ForegroundColor}"
			TextAlignment="{Binding TextAlignment}"
			>			
		</TextBlock>
	</Grid>
</UserControl>
