<UserControl
	x:Class="Lyt.PhotoPostPro.Workflow.Book.Edit.SlotView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Book.Edit"
	x:DataType="vm:SlotViewModel"

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	Background="Transparent"

	Width="{Binding Dx, Mode=OneWay}"
	Height="{Binding Dy, Mode=OneWay}"
	Canvas.Top="{Binding Y, Mode=OneWay}"
	Canvas.Left="{Binding X, Mode=OneWay}"
	>
	<Border
		BorderThickness="0"
		ClipToBounds="False"
		>
		<Grid
			x:Name="OuterGrid"
			Background="#24CCAAFF"
			ClipToBounds="False"
			IsHitTestVisible="True"
			>
			<Image
				IsVisible="{Binding IsImageSlot}"
				Source="{Binding SlotImage}"
				VerticalAlignment="Top" HorizontalAlignment="Left"
				Stretch="{Binding ImageStretch}"
				IsHitTestVisible="False"
				>			
			</Image>
			<PathIcon
				IsVisible="{Binding IsNotSuitableForPrint}"
				VerticalAlignment="Top" HorizontalAlignment="Right"
				Width="40" Height="40"
				Margin="0 30 30 0"
				Foreground="{Binding WarningBrush}"
				Data="{StaticResource path_warning}"
				>				
			</PathIcon>

			<TextBlock
				IsVisible="{Binding IsTextBlockVisible}"
				Text="{Binding SlotText}"
				FontFamily="{Binding SlotFontFamily}"
				FontSize="{Binding SlotFontSize}"
				FontStyle="{Binding SlotFontStyle}"
				Foreground="{Binding SlotForegroundColor}"
				TextAlignment="{Binding SlotTextAlignment}"
				TextWrapping="Wrap"
				IsHitTestVisible="False"
				>			
			</TextBlock>
			<TextBox
				x:Name="SlotTextBox"
				LostFocus="OnSlotTextBoxLostFocus"
				IsVisible="{Binding IsTextBoxVisible}"
				IsHitTestVisible="{Binding IsTextBoxVisible}"
				Text="{Binding SlotText}"
				FontFamily="{Binding SlotFontFamily}"
				FontSize="{Binding SlotFontSize}"
				FontStyle="{Binding SlotFontStyle}"
				Foreground="{Binding SlotForegroundColor}"
				TextAlignment="{Binding SlotTextAlignment}"
				AcceptsReturn="True"
				AcceptsTab="True"
				TextWrapping="Wrap"
				>			
			</TextBox>
			<Rectangle
				IsVisible="{Binding IsSlotBorderVisible}"
				Fill="Transparent"
				Stroke="{Binding SlotBorderBrush}"
				StrokeThickness="2"
				StrokeDashArray="2, 2"
				IsHitTestVisible="False"
				/>
		</Grid>
	</Border>
</UserControl>
