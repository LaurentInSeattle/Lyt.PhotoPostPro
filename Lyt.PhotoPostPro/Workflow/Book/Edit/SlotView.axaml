<UserControl
	x:Class="Lyt.PhotoPostPro.Workflow.Book.Edit.SlotView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Book.Edit"
	x:DataType="vm:SlotViewModel"

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	Background="Transparent"
	>
	<Border
		Width="{Binding SlotWidth}"
		Height="{Binding SlotHeight}"
		Canvas.Top="{Binding SlotY}"
		Canvas.Left="{Binding SlotX}"
		BorderThickness="0"
		>
		<Grid
			x:Name="OuterGrid"
			Background="Transparent"
			IsHitTestVisible="True"
			>
			<Image
				IsVisible="{Binding IsImageSlot}"
				Source="{Binding SlotImage}"
				VerticalAlignment="Top" HorizontalAlignment="Stretch"
				Stretch="{Binding ImageStretch}"
				IsHitTestVisible="False"
				>			
			</Image>
			<TextBlock
				IsVisible="{Binding !IsImageSlot}"
				Text="{Binding SlotText}"
				FontFamily="{Binding SlotFontFamily}"
				FontSize="{Binding SlotFontSize}"
				FontStyle="{Binding SlotFontStyle}"
				Foreground="{Binding SlotForegroundColor}"
				TextAlignment="{Binding SlotTextAlignment}"
				IsHitTestVisible="False"
				>			
			</TextBlock>
			<Rectangle
				IsVisible="{Binding IsSlotBorderVisible}"
				Fill="Transparent"
				Stroke="{Binding SlotBorderBrush}"
				StrokeThickness="2"
				StrokeDashArray="2, 2"
				IsHitTestVisible="False"
				/>
		</Grid>
	</Border>
</UserControl>
