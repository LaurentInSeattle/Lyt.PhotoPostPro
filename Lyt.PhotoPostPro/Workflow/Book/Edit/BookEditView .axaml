<UserControl
	x:Class="Lyt.PhotoPostPro.Workflow.Book.Edit.BookEditView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Book.Edit"
	x:DataType="vm:BookEditViewModel"

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:images="clr-namespace:Lyt.Avalonia.Controls.Images;assembly=Lyt.Avalonia.Controls"
	xmlns:local="using:Lyt.PhotoPostPro.Workflow.Book.Edit"
	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"
	xmlns:toggle="clr-namespace:Lyt.Avalonia.Controls.Toggle;assembly=Lyt.Avalonia.Controls"

	Background="Transparent"
	>
	<Grid
		x:Name="BookEditMainGrid"
		>
		<Grid.RowDefinitions>
			<RowDefinition Height="4" />
			<RowDefinition Height="*" />
			<RowDefinition Height="4" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="4" />
			<ColumnDefinition Width="228" /> <!-- Film Strip --> 
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="0" /> <!-- Tools --> 
			<ColumnDefinition Width="4" />
		</Grid.ColumnDefinitions>

		<!-- Same background as ShellView, here again so that we have it when in full screen mode --> 
		<Image
			Grid.Column="0" Grid.ColumnSpan="999" Grid.RowSpan="999"
			Stretch="UniformToFill"
			Source="\Assets\Images\sky.jpg"
			Opacity="0.7"
			/>

		<!-- Film Strip --> 
		<ListBox
			x:Name="StripListBox"
			Grid.Row="1" Grid.Column="1"
			ItemsSource="{Binding ImageThumbnails}"
			SelectedIndex="{Binding SelectedThumbnailIndex}"
			SelectionMode="Single"
			ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			> 
			<ListBox.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel 
						Background="Transparent"
						Orientation="Vertical" 
						/>
				</ItemsPanelTemplate>
			</ListBox.ItemsPanel>
			<ListBox.ItemTemplate>
				<DataTemplate>
					<local:BookImageView 
						Margin="4 0 24 0"
						Width="200" MaxHeight="180"
						/>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<!-- Tools Hidden for now  --> 
		<Rectangle
			Fill="Teal"
			Grid.Column="3" Grid.Row="1"
			/>

		<!-- Center Area  --> 
		<Grid
			Grid.Column="2" Grid.Row="1"
			>
			<Grid.RowDefinitions>
				<RowDefinition Height="132" /> <!-- Doc Preview --> 
				<RowDefinition Height="64" /> <!-- Toolbar --> 
				<RowDefinition Height="*" /> <!-- Edit --> 
				<RowDefinition Height="32" /> <!-- Pips --> 
				<RowDefinition Height="120" /> <!-- Templates --> 
			</Grid.RowDefinitions>
			<Grid
				Background="#80000020"
				Grid.Row="0"
				VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
				>
				<!-- Preview --> 
				<ListBox
					x:Name="PdfPreviewListBox"
					ItemsSource="{Binding PdfThumbnails}"
					SelectedIndex="{Binding SelectedPdfThumbnailIndex}"
					SelectionMode="Single"
					ScrollViewer.VerticalScrollBarVisibility="Disabled"
					ScrollViewer.HorizontalScrollBarVisibility="Auto"
					> 
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<VirtualizingStackPanel 
								Background="Transparent"
								Orientation="Horizontal" 
								/>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Image 
								Source="{Binding Bitmap}" 
								Height="{Binding Height}" Width="{Binding Width}"
								Stretch="Uniform"
								Margin="0 0 0 16"
								/>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

			</Grid>
			
			<!-- Toolbar  --> 
			<Grid
				Grid.Row="1"
				Background="#40000020"
				>
				<StackPanel
					Orientation="Horizontal"
					>					
					<toggle:ToggleSwitch
						x:Name="ModeSwitch"
						Margin="8 0 8 0"
						Style="{StaticResource StandardToggleSwitch}"
						TrueText="1"
						FalseText="2"
						Height="30" Width="140"
						HorizontalAlignment="Center" VerticalAlignment="Center"
						Value="{Binding IsSingleImageMode}"
						/>
					<toggle:ToggleSwitch
						x:Name="ShowGridLinesSwitch"
						Margin="8 0 8 0"
						Style="{StaticResource StandardToggleSwitch}"
						TrueText="Grid"
						FalseText="Hide"
						Height="30" Width="160"
						HorizontalAlignment="Center" VerticalAlignment="Center"
						Value="{Binding ShowGridLines}"
						/>
					<glyphs:GlyphButton
						Style="{StaticResource PanelIconButton}"
						Layout="IconOnly"
						GlyphSource="add_circle"
						GlyphStrokeThickness="0.1"
						Command="{Binding OnAddPageBefore}"
						Width="64" Height="36" 
						Margin="10 0 0 0"
						ToolTip.Tip="Add Page BEFORE current"
						/>
					<glyphs:GlyphButton
						Style="{StaticResource PanelIconButton}"
						Layout="IconOnly"
						GlyphSource="delete"
						GlyphStrokeThickness="0.1"
						Command="{Binding OnDeletePage}"
						CommandParameter="Check"
						Width="64" Height="36" 
						Margin="20 0 0 0"
						ToolTip.Tip="Delete current page"
						/>
					<glyphs:GlyphButton
						Style="{StaticResource PanelIconButton}"
						Layout="IconOnly"
						GlyphSource="add_circle"
						GlyphStrokeThickness="0.1"
						Command="{Binding OnAddPageAfter}"
						Width="64" Height="36" 
						Margin="10 0 0 0"
						ToolTip.Tip="Add Page AFTER current"
						/>
				</StackPanel>
			</Grid>

			<!-- Pages --> 
			<Viewbox
				Grid.Row="2"
				IsVisible="{Binding DoublePageMode}"
				>
				<Carousel 
					Name="DoublePagesCarousel"
					ItemsSource="{Binding DoublePages}"
					SelectedIndex="{Binding DoublePagesIndex}"
					>
					<Carousel.PageTransition>
						<PageSlide Duration="0:00:00.250" Orientation="Horizontal" />
					</Carousel.PageTransition>
					<Carousel.ItemTemplate>
						<DataTemplate>
							<vm:BookDoublePageView Margin="0" />
						</DataTemplate>
					</Carousel.ItemTemplate>
				</Carousel>		
			</Viewbox>
			<LayoutTransformControl
				Grid.Row="3"
				IsVisible="{Binding DoublePageMode}"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				>
				<LayoutTransformControl.LayoutTransform>
					<ScaleTransform ScaleX="1.7" ScaleY="1.7" />
				</LayoutTransformControl.LayoutTransform>
				<PipsPager 
					NumberOfPages="{Binding DoublePages.Count}"
					SelectedPageIndex="{Binding #DoublePagesCarousel.SelectedIndex, Mode=TwoWay}"
					Foreground="{StaticResource LightAqua_0_120}"
				   />
			</LayoutTransformControl>
			<Viewbox
				Grid.Row="2"
				IsVisible="{Binding !DoublePageMode}"
				>
				<Carousel 
					Name="SinglePagesCarousel"
					ItemsSource="{Binding SinglePages}"
					SelectedIndex="{Binding SinglePagesIndex}"
					>					
					<Carousel.PageTransition>
						<PageSlide Duration="0:00:00.250" Orientation="Horizontal" />
					</Carousel.PageTransition>
					<Carousel.ItemTemplate>
						<DataTemplate>
							<vm:BookPageView Margin="0" />
						</DataTemplate>
					</Carousel.ItemTemplate>
				</Carousel>		
			</Viewbox>
			<LayoutTransformControl
				Grid.Row="3"
				IsVisible="{Binding !DoublePageMode}"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				>
				<LayoutTransformControl.LayoutTransform>
					<ScaleTransform ScaleX="1.7" ScaleY="1.7" />
				</LayoutTransformControl.LayoutTransform>
				<PipsPager 
					NumberOfPages="{Binding SinglePages.Count}"
					SelectedPageIndex="{Binding #SinglePagesCarousel.SelectedIndex, Mode=TwoWay}"
					Foreground="{StaticResource LightAqua_0_120}"
				   />
			</LayoutTransformControl>

			<Rectangle
				Fill="#0180A060"
				Grid.Row="4"
				VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
				/>
		</Grid>
		<Canvas
			x:Name="BookEditDragCanvas"
			Grid.Column="0" Grid.ColumnSpan="999" Grid.Row="0" Grid.RowSpan="999"
			>
			
		</Canvas>
	</Grid>
</UserControl>
