<UserControl
	x:Class="Lyt.PhotoPostPro.Workflow.Book.Edit.BookEditView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Book.Edit"
	x:DataType="vm:BookEditViewModel"

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:images="clr-namespace:Lyt.Avalonia.Controls.Images;assembly=Lyt.Avalonia.Controls"
	xmlns:local="using:Lyt.PhotoPostPro.Workflow.Documentation"
	xmlns:shared="clr-namespace:Lyt.PhotoPostPro.Workflow.Shared"
	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"
	xmlns:meta="clr-namespace:Lyt.PhotoPostPro.Panes.MetadataPane"

	Background="Transparent"
	>
	<Grid
		>
		<Grid.RowDefinitions>
			<RowDefinition Height="4" />
			<RowDefinition Height="*" />
			<RowDefinition Height="4" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="4" />
			<ColumnDefinition Width="240" /> <!-- Film Strip --> 
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="0" /> <!-- Tools --> 
			<ColumnDefinition Width="4" />
		</Grid.ColumnDefinitions>

		<Rectangle
			Fill="Teal"
			Grid.Column="1" Grid.Row="1"
			/>
		<Rectangle
			Fill="Teal"
			Grid.Column="3" Grid.Row="1"
			/>
		<Grid
			Grid.Column="2" Grid.Row="1"
			>
			<Grid.RowDefinitions>
				<RowDefinition Height="180" /> <!-- Doc Preview --> 
				<RowDefinition Height="90" /> <!-- Nav --> 
				<RowDefinition Height="*" /> <!-- Edit --> 
				<RowDefinition Height="120" /> <!-- Templates --> 
			</Grid.RowDefinitions>
			<Rectangle
				Fill="#80000060"
				Grid.Row="0"
				VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
				/>
			<Rectangle
				Fill="#80800060"
				Grid.Row="1"
				VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
				/>
			<Rectangle
				Fill="#8080A060"
				Grid.Row="3"
				VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
				/>
			<Viewbox
				Grid.Row="2"
				>
				<!-- 
				// TODO : Bind these numbers 
				PageSize Letter (612, 792);  
					Width="1584" Height="612"
				PageSize A4 (595f, 842f);
					Width="1684" Height="595"
				-->
				<Grid
					Width="1596" Height="620"
					>
					<Grid.RowDefinitions>
						<RowDefinition Height="4" /> 
						<RowDefinition Height="612" /> 
						<RowDefinition Height="4" /> 
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="4" />
						<ColumnDefinition Width="792" /> 
						<ColumnDefinition Width="4" />
						<ColumnDefinition Width="792" /> 
						<ColumnDefinition Width="4" />
					</Grid.ColumnDefinitions>
					<Canvas 
						Grid.Row="1" Grid.Column="1"
						Width="792" Height="612"
						Background="#80A0B040"
						>					
					</Canvas>
					<Canvas 
						Grid.Row="1" Grid.Column="3"
						Width="792" Height="612"
						Background="#80A0B040"
						>					
					</Canvas>
				</Grid>
			</Viewbox>
		</Grid>
	</Grid>
</UserControl>
