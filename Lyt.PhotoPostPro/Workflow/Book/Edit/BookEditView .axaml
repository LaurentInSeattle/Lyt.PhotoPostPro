<UserControl
	x:Class="Lyt.PhotoPostPro.Workflow.Book.Edit.BookEditView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Book.Edit"
	x:DataType="vm:BookEditViewModel"

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:images="clr-namespace:Lyt.Avalonia.Controls.Images;assembly=Lyt.Avalonia.Controls"
	xmlns:local="using:Lyt.PhotoPostPro.Workflow.Documentation"
	xmlns:shared="clr-namespace:Lyt.PhotoPostPro.Workflow.Shared"
	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"
	xmlns:meta="clr-namespace:Lyt.PhotoPostPro.Panes.MetadataPane"

	Background="Transparent"
	>
	<Grid
		>
		<Grid.RowDefinitions>
			<RowDefinition Height="4" />
			<RowDefinition Height="*" />
			<RowDefinition Height="4" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="4" />
			<ColumnDefinition Width="240" /> <!-- Film Strip --> 
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="0" /> <!-- Tools --> 
			<ColumnDefinition Width="4" />
		</Grid.ColumnDefinitions>

		<!-- Same background as ShellView, here again so that we have it when in full screen mode --> 
		<Image
			Grid.Column="0" Grid.ColumnSpan="999" Grid.RowSpan="999"
			Stretch="UniformToFill"
			Source="\Assets\Images\sky.jpg"
			Opacity="0.7"
			/>

		<!-- Film Strip --> 
		<ListBox
			x:Name="StripListBox"
			Grid.Row="1" Grid.Column="1"
			ItemsSource="{Binding ImageThumbnails}"
			SelectedIndex="{Binding SelectedThumbnailIndex}"
			SelectedItems="{Binding SelectedThumbnails, Mode=TwoWay}"
			SelectionMode="Single"
			ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			> 
			<ListBox.ItemsPanel>
				<ItemsPanelTemplate>
					<VirtualizingStackPanel 
						Background="Transparent"
						Orientation="Vertical" 
						/>
				</ItemsPanelTemplate>
			</ListBox.ItemsPanel>
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Image 
						Margin="4 0 24 0"
						Source="{Binding Bitmap}" 
						Width="190" MaxHeight="150"
						/>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<!-- Tools Hidden for now  --> 
		<Rectangle
			Fill="Teal"
			Grid.Column="3" Grid.Row="1"
			/>


		<Grid
			Grid.Column="2" Grid.Row="1"
			>
			<Grid.RowDefinitions>
				<RowDefinition Height="128" /> <!-- Doc Preview --> 
				<RowDefinition Height="64" /> <!-- Nav --> 
				<RowDefinition Height="*" /> <!-- Edit --> 
				<RowDefinition Height="32" /> <!-- Pips --> 
				<RowDefinition Height="120" /> <!-- Templates --> 
			</Grid.RowDefinitions>
			<Rectangle
				Fill="#80000060"
				Grid.Row="0"
				VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
				/>
			<Rectangle
				Fill="#80800060"
				Grid.Row="1"
				VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
				/>
			<Rectangle
				Fill="#8080A060"
				Grid.Row="4"
				VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
				/>
			<Viewbox
				Grid.Row="2"
				>
				<Carousel 
					Name="DoublePagesCarousel"
					ItemsSource="{Binding DoublePages}"
					SelectedIndex="{Binding DoublePagesIndex}">
					
					<Carousel.PageTransition>
						<PageSlide Duration="0:00:00.250" Orientation="Horizontal" />
					</Carousel.PageTransition>
					<Carousel.ItemTemplate>
						<DataTemplate>
							<vm:BookDoublePageView Margin="0" />
						</DataTemplate>
					</Carousel.ItemTemplate>
				</Carousel>		
			</Viewbox>
			<LayoutTransformControl
				Grid.Row="3"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				>
				<LayoutTransformControl.LayoutTransform>
					<ScaleTransform ScaleX="1.7" ScaleY="1.7" />
				</LayoutTransformControl.LayoutTransform>
				<PipsPager 
					NumberOfPages="{Binding DoublePages.Count}"
					SelectedPageIndex="{Binding #DoublePagesCarousel.SelectedIndex, Mode=TwoWay}"
					Foreground="{StaticResource LightAqua_0_120}"
				   />
			</LayoutTransformControl>
		</Grid>
	</Grid>
</UserControl>
