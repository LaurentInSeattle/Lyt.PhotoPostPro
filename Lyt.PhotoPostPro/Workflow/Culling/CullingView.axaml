<UserControl 
	x:Class="Lyt.PhotoPostPro.Workflow.Culling.CullingView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Culling"
	x:DataType="vm:CullingViewModel" 
	
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:images="clr-namespace:Lyt.Avalonia.Controls.Images;assembly=Lyt.Avalonia.Controls"
	xmlns:shared="clr-namespace:Lyt.PhotoPostPro.Workflow.Shared"
	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"
	xmlns:metadatapane="using:Lyt.PhotoPostPro.Panes.MetadataPane"
	xmlns:stars="clr-namespace:Lyt.Avalonia.Controls.StarRating;assembly=Lyt.Avalonia.Controls"

	Background="Transparent"
	>
	<Grid	
		x:Name="ToasterHost"
		> 
		<Grid.RowDefinitions>
			<RowDefinition Height="4" />
			<RowDefinition Height="*" />
			<RowDefinition Height="4" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="8" />
			<ColumnDefinition Width="240" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="8" />
		</Grid.ColumnDefinitions>
		<!-- Same background as ShellView, here again so that we have it when in full screen mode --> 
		<Image
			Grid.Column="0" Grid.ColumnSpan="999" Grid.RowSpan="999"
			Stretch="UniformToFill"
			Source="\Assets\Images\sky.jpg"
			Opacity="0.7"
			/>
		<!-- Film strip on the left side --> 
		<Rectangle
			Grid.Row="1" Grid.Column="1"
			Fill="#60000020"
			/>
		<ListBox
			x:Name="StripListBox"
			Grid.Row="1" Grid.Column="1"
			ItemsSource="{Binding ImageThumbnails}"
			SelectedIndex="{Binding SelectedThumbnailIndex}"
			SelectedItems="{Binding SelectedThumbnails, Mode=TwoWay}"
			SelectionMode="Multiple"
			ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			> 
			<ListBox.ItemsPanel>
				<ItemsPanelTemplate>
					<VirtualizingStackPanel 
						Background="Transparent"
						Orientation="Vertical" 
						/>
				</ItemsPanelTemplate>
			</ListBox.ItemsPanel>
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Image 
						Margin="4 0 24 0"
						Source="{Binding Bitmap}" 
						Width="190" MaxHeight="150"
						/>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<!-- Center area --> 
		<Grid
			x:Name="CenterGrid"
			Grid.Row="1" Grid.Column="2"
			> 
			<Grid.RowDefinitions>
				<RowDefinition Height="0" /> <!-- Reserved FFU -->
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<!-- Spinner in the middle--> 
			<Grid
				Grid.Row="1" 
				Background="{StaticResource DeepBlue_0_040}"
				>
				<Grid.RowDefinitions>
					<RowDefinition Height="40" /> 
					<RowDefinition Height="300" />
				</Grid.RowDefinitions>
				<TextBlock
					Grid.Row="0"
					Theme="{StaticResource H2}"
					Text="{Binding Status}"
					IsVisible="{Binding StatusIsVisible}"
					Foreground="{StaticResource OrangePeel_1_100}"
					Margin="4 4 4 4"
					TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
					/>
				<shared:SpinView
					Margin="4" Grid.Row="1"
					DataContext="{Binding SpinViewModel}"
					HorizontalAlignment="Center" VerticalAlignment="Center"
					Width="480" Height="320"
					/>
			</Grid>

			<!-- Single Image Layout --> 
			<Grid
				IsVisible="{Binding SingleImageLayoutIsVisible}"
				Grid.Row="1" 
				> 
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="8" />
					<ColumnDefinition Width="480" />
				</Grid.ColumnDefinitions>
				<vm:CullingImageView
					Margin="4"
					DataContext="{Binding SingleImageViewModel}"
					HorizontalAlignment="Center"  VerticalAlignment="Center"
					/>
				<!-- Single Image Layout Control Panel --> 
				<Grid
					Width="480" Height="300"
					Grid.Column="2"
					VerticalAlignment="Top"
					> 
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="40" /> <!-- Reserved FFU -->
						<RowDefinition Height="{StaticResource Size.TallSpacer}" />
						<RowDefinition Height="64" /> <!-- + or - star -->
						<RowDefinition Height="{StaticResource Size.PromptOneLine}" />
						<RowDefinition Height="{StaticResource Size.TallSpacer}" />
						<RowDefinition Height="64" /> <!-- Reject -->
						<RowDefinition Height="{StaticResource Size.PromptOneLine}" />
						<RowDefinition Height="{StaticResource Size.TallSpacer}" />
						<RowDefinition Height="500" />
					</Grid.RowDefinitions>
					<glyphs:GlyphButton
						x:Name="RemoveStarButton"
						Grid.Row="2" Grid.Column="0"
						Style="{StaticResource ViewIconButton}"
						FontSize="24"
						HorizontalAlignment="Center" VerticalAlignment="Center"
						Width="220" Height="56"
						GlyphSource="star_off"
						ButtonBackground="BorderlessRectangle"
						GlyphStrokeThickness="0"
						Text="{DynamicResource Workflow.Culling.RemoveStar}"
						Command="{Binding OnRemoveStar}"
						/>
					<TextBlock
						Grid.Row="3" Grid.Column="0" 
						Theme="{StaticResource Small}"
						IsVisible="{Binding ShowHints}"
						HorizontalAlignment="Center"
						Text="Delete"
						/>
					<glyphs:GlyphButton
						x:Name="AddStarButton"
						Grid.Row="2" Grid.Column="1"
						Style="{StaticResource ViewIconButton}"
						FontSize="24"
						HorizontalAlignment="Center" VerticalAlignment="Center"
						Width="220" Height="56"
						GlyphSource="star_emphasis"
						ButtonBackground="BorderlessRectangle"
						GlyphStrokeThickness="0"
						Text="{DynamicResource Workflow.Culling.AddStar}"
						Command="{Binding OnAddStar}"
						/>
					<TextBlock
						Grid.Row="3" Grid.Column="1" 
						Theme="{StaticResource Small}"
						IsVisible="{Binding ShowHints}"
						HorizontalAlignment="Center"
						Text="Insert"
						/>
					<glyphs:GlyphButton
						x:Name="RejectButton"
						Grid.Row="5" Grid.ColumnSpan="2"
						Style="{StaticResource ViewIconButton}"
						FontSize="24"
						HorizontalAlignment="Center" VerticalAlignment="Center"
						Width="460" Height="56"
						GlyphSource="delete"
						ButtonBackground="BorderlessRectangle"
						GlyphStrokeThickness="0"
						Text="{DynamicResource Workflow.Culling.Reject}"
						Command="{Binding OnReject}"
						/>
					<TextBlock
						Grid.Row="6" Grid.ColumnSpan="2" 
						Theme="{StaticResource Small}"
						IsVisible="{Binding ShowHints}"
						HorizontalAlignment="Center"
						Text="Backspace"
						/>
					<metadatapane:MetadataView
						DataContext="{Binding SelectedImageMetadataViewModel}"
						HorizontalAlignment="Stretch" 
						Grid.Row="8" Grid.ColumnSpan="2"
						Margin="4 0 4 0"
						/>
				</Grid>
			</Grid>
			<!-- Dual Landscape Image Layout --> 
			<Grid
				IsVisible="{Binding DualLandscapeImageLayoutIsVisible}"
				Grid.Row="1" 
				> 
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="8" />
					<ColumnDefinition Width="480" />
				</Grid.ColumnDefinitions>
				<vm:CullingImageView
					Margin="4"
					DataContext="{Binding SingleImageViewModelTopOrLeft}"
					HorizontalAlignment="Center"  VerticalAlignment="Center"
					/>
				<vm:CullingImageView
					Grid.Row="1" 
					Margin="4"
					DataContext="{Binding SingleImageViewModelBottomOrRight}"
					HorizontalAlignment="Center"  VerticalAlignment="Center"
					/>
				<!-- Dual Landscape Image Layout Control Panel --> 
				<Grid
					Grid.Column="2"
					VerticalAlignment="Top"
					> 
					<Grid.RowDefinitions>
						<RowDefinition Height="40" /> <!-- Reserved FFU -->
						<RowDefinition Height="{StaticResource Size.TallSpacer}" />
						<RowDefinition Height="64" /> <!-- Select Top -->
						<RowDefinition Height="{StaticResource Size.PromptOneLine}" />
						<RowDefinition Height="{StaticResource Size.TallSpacer}" />
						<RowDefinition Height="64" /> <!-- Select Bottom -->
						<RowDefinition Height="{StaticResource Size.PromptOneLine}" />
						<RowDefinition Height="{StaticResource Size.TallSpacer}" />
						<RowDefinition Height="50" />
					</Grid.RowDefinitions>
					<glyphs:GlyphButton
						x:Name="SelectTopButton"
						Grid.Row="2" 
						Style="{StaticResource ViewIconButton}"
						FontSize="24"
						HorizontalAlignment="Center" VerticalAlignment="Center"
						Width="460" Height="56"
						GlyphSource="caret_up"
						ButtonBackground="BorderlessRectangle"
						GlyphStrokeThickness="0"
						Text="{DynamicResource Workflow.Culling.SelectTop}"
						Command="{Binding OnSelectTopOrLeft}"
						/>
					<TextBlock
						Grid.Row="3" Grid.Column="1" 
						Theme="{StaticResource Small}"
						IsVisible="{Binding ShowHints}"
						HorizontalAlignment="Center"
						Text="{DynamicResource Workflow.Culling.SelectTopHint}"
						/>
					<glyphs:GlyphButton
						x:Name="SelectBottomButton"
						Grid.Row="5" Grid.ColumnSpan="2"
						Style="{StaticResource ViewIconButton}"
						FontSize="24"
						HorizontalAlignment="Center" VerticalAlignment="Center"
						Width="460" Height="56"
						GlyphSource="caret_down"
						ButtonBackground="BorderlessRectangle"
						GlyphStrokeThickness="0"
						Text="{DynamicResource Workflow.Culling.SelectBottom}"
						Command="{Binding OnSelectBottomOrRight}"
						/>
					<TextBlock
						Grid.Row="6" Grid.ColumnSpan="2" 
						Theme="{StaticResource Small}"
						IsVisible="{Binding ShowHints}"
						HorizontalAlignment="Center"
						Text="{DynamicResource Workflow.Culling.SelectBottomHint}"
						/>
				</Grid>
			</Grid>

			<!-- Dual Portrait Image Layout --> 
			<Grid
				IsVisible="{Binding DualPortraitImageLayoutIsVisible}"
				Grid.Row="1" 
				> 
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" /> 
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<vm:CullingImageView
					Margin="4" Grid.Row="1"
					DataContext="{Binding SingleImageViewModelTopOrLeft}"
					HorizontalAlignment="Center"  VerticalAlignment="Center"
					/>
				<vm:CullingImageView
					Margin="4"
					Grid.Row="1" Grid.Column="1"
					DataContext="{Binding SingleImageViewModelBottomOrRight}"
					HorizontalAlignment="Center"  VerticalAlignment="Center"
					/>
				<!-- Dual Portrait Image Layout --> 
				<Grid
					Grid.Row="0" Grid.ColumnSpan="2"
					VerticalAlignment="Top"
					> 
					<Grid.RowDefinitions>
						<RowDefinition Height="64" /> <!-- Select Top -->
						<RowDefinition Height="{StaticResource Size.PromptOneLine}" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<glyphs:GlyphButton
						x:Name="SelectLeftButton"
						Grid.Row="0" Grid.Column="0" 
						Style="{StaticResource ViewIconButton}"
						FontSize="24"
						HorizontalAlignment="Center" VerticalAlignment="Center"
						Width="460" Height="56"
						GlyphSource="caret_left"
						ButtonBackground="BorderlessRectangle"
						GlyphStrokeThickness="0"
						Text="{DynamicResource Workflow.Culling.SelectLeft}"
						Command="{Binding OnSelectTopOrLeft}"
						/>
					<TextBlock
						Grid.Row="1" Grid.Column="0" 
						Theme="{StaticResource Small}"
						IsVisible="{Binding ShowHints}"
						HorizontalAlignment="Center"
						Text="{DynamicResource Workflow.Culling.SelectTopHint}"
						/>
					<glyphs:GlyphButton
						x:Name="SelectRightButton"
						Grid.Row="0" Grid.Column="1"
						Style="{StaticResource ViewIconButton}"
						Layout="IconTextLeftSide"
						FontSize="24"
						HorizontalAlignment="Center" VerticalAlignment="Center"
						Width="460" Height="56"
						GlyphSource="caret_right"
						ButtonBackground="BorderlessRectangle"
						GlyphStrokeThickness="0"
						Text="{DynamicResource Workflow.Culling.SelectRight}"
						Command="{Binding OnSelectBottomOrRight}"
						/>
					<TextBlock
						Grid.Row="1" Grid.Column="1" 
						Theme="{StaticResource Small}"
						IsVisible="{Binding ShowHints}"
						HorizontalAlignment="Center"
						Text="{DynamicResource Workflow.Culling.SelectRightHint}"
						/>
				</Grid>
				<Grid

					> 
				</Grid>
			</Grid>

			<!-- Many Images Layout: 3 or more , or two in distinct orientations --> 
			<ItemsControl 
				Grid.Row="1" 
				IsVisible="{Binding ManyImagesLayoutIsVisible}"
				ItemsSource="{Binding SelectedImages}"
				>
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>	  
				<ItemsControl.ItemTemplate>
					<DataTemplate >
						<Image 
							Margin="4"
							Source="{Binding Bitmap}" 
							Stretch="Uniform" 
							HorizontalAlignment="Center"  VerticalAlignment="Center"
							RenderOptions.BitmapInterpolationMode="HighQuality"
							/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<!-- Many Images Layout: 3 or more  - Control Panel - Nothing for now --> 
			<Grid
				IsVisible="{Binding ManyImagesLayoutIsVisible}"
				> 
			</Grid>
		</Grid>
	</Grid>
</UserControl>
