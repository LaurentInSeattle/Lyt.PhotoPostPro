<UserControl 
	x:Class="Lyt.PhotoPostPro.Workflow.Import.ImportView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Import"
	x:DataType="vm:ImportViewModel" 
	
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:shared="clr-namespace:Lyt.PhotoPostPro.Workflow.Shared"
	xmlns:file="clr-namespace:Lyt.PhotoPostPro.Workflow.Import.File"
	xmlns:folder="clr-namespace:Lyt.PhotoPostPro.Workflow.Import.Folder"

	Background="Transparent"
	>
	<Grid	
		x:Name="ToasterHost"
		> 
		<Grid.RowDefinitions>
			<RowDefinition Height="4" />
			<RowDefinition Height="*" />
			<RowDefinition Height="4" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="8" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="8" />
		</Grid.ColumnDefinitions>
		<shared:DropView
			Grid.Row="1" Grid.Column="1"
			DataContext="{Binding DropViewModel}"
			Width="472" 
			HorizontalAlignment="Center" VerticalAlignment="Center"
			/>
		<file:FileImportView
			Grid.Row="1" Grid.Column="1"
			DataContext="{Binding FileImportViewModel}"
			/>
		<folder:FolderImportView
			Grid.Row="1" Grid.Column="1"
			DataContext="{Binding FolderImportViewModel}"
			/>
	</Grid>
</UserControl>
