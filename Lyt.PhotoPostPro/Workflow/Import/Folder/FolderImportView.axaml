<UserControl 
	x:Class="Lyt.PhotoPostPro.Workflow.Import.Folder.FolderImportView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Import.Folder"
	x:DataType="vm:FolderImportViewModel" 
	
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:images="clr-namespace:Lyt.Avalonia.Controls.Images;assembly=Lyt.Avalonia.Controls"
	xmlns:shared="clr-namespace:Lyt.PhotoPostPro.Workflow.Shared"
	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"
	xmlns:meta="clr-namespace:Lyt.PhotoPostPro.Panes.MetadataPane"

	Background="Transparent"
	IsVisible="{Binding IsFolderMode}"
	>
	<Grid	
		x:Name="ToasterHost"
		> 
		<Grid.RowDefinitions>
			<RowDefinition Height="4" />
			<RowDefinition Height="*" />
			<RowDefinition Height="120" />
			<RowDefinition Height="80" />
			<RowDefinition Height="*" />
			<RowDefinition Height="4" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="8" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="480" />
			<ColumnDefinition Width="8" />
		</Grid.ColumnDefinitions>

		<TextBlock
			Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2"
			IsVisible="{Binding IsMessageVisible}"
			Text="{Binding Message}"
			Theme="{StaticResource H2}"
			MaxWidth="480" 
			TextWrapping="Wrap"
			HorizontalAlignment="Center" VerticalAlignment="Center"
			/>
		<glyphs:GlyphButton
			Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3"
			IsVisible="{Binding IsMessageVisible}"
			Style="{StaticResource ViewIconButton}"
			FontSize="24"
			HorizontalAlignment="Center" VerticalAlignment="Center"
			Width="472" Height="56"
			GlyphSource="chevron_left"
			ButtonBackground="BorderlessRectangle"
			GlyphStrokeThickness="0"
			Text="{DynamicResource Workflow.Back}"
			Command="{Binding OnBack}"
	    	/>

		<ScrollViewer
			Grid.Column="1" Grid.Row="1" Grid.RowSpan="4"
			Width="780"
			IsVisible="{Binding AreStatisticsVisible}"
			Background="Transparent"
			VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
			ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			ScrollViewer.VerticalScrollBarVisibility="Auto"
			>
			<ItemsControl 
				ItemsSource="{Binding ImageCategories}"
				Margin="0 0 24 0"
				>
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<VirtualizingStackPanel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<vm:ImageCategoryView Margin="0 12 0 12" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

	</Grid>
</UserControl>
