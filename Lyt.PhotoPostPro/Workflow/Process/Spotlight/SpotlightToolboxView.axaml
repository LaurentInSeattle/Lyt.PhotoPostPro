<UserControl 
	x:Class="Lyt.PhotoPostPro.Workflow.Process.Spotlight.SpotlightToolboxView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Process.Spotlight"
	x:DataType="vm:SpotlightToolboxViewModel" 

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="72"

	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"
	xmlns:controls="clr-namespace:Lyt.PhotoPostPro.Controls"
	>	
	<Grid
		>
		<Grid.RowDefinitions>
			<RowDefinition Height="{StaticResource Size.PromptTwoLines}" /> <!-- Prompt Spotlight --> 
			<RowDefinition Height="{StaticResource Size.Spacer}" /> <!-- --> 
			<RowDefinition Height="{StaticResource Size.PromptOneLine}" /> <!-- Prompt Sides --> 
			<RowDefinition Height="{StaticResource Size.ThreeSliders}" /> <!-- Three sliders, X Y and Rotation --> 
			<RowDefinition Height="{StaticResource Size.Spacer}" /> <!-- --> 
			<RowDefinition Height="{StaticResource Size.PromptOneLine}" /> <!-- Prompt Lightness --> 
			<RowDefinition Height="{StaticResource Size.OneSlider}" /> <!-- Lightness --> 
		</Grid.RowDefinitions>
		<TextBlock
			Grid.Row="0" 
			Text="{DynamicResource Workflow.Vignette.Correction}"
			Theme="{StaticResource Large}"
			TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"
			/>
		<TextBlock
			Grid.Row="2" 
			Text="{DynamicResource Workflow.Vignette.Sides}"
			Theme="{StaticResource Large}"
			TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"
			/>
		<Grid
			Grid.Row="3" 
			> 
			<Grid.RowDefinitions> 
				<RowDefinition Height="*" />
				<RowDefinition Height="*" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions> 
				<ColumnDefinition Width="100" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="70" />
			</Grid.ColumnDefinitions>
			<!-- First Row: X Axis -->
			<TextBlock
				Grid.Row="0" Grid.Column="0" 
				Theme="{StaticResource Large}"
				HorizontalAlignment="Right"
				Text="{DynamicResource Workflow.Spotlight.Width}"
				/>
			<Slider 
				Grid.Row="0" Grid.Column="1" 
				TickFrequency="50" TickPlacement="BottomRight"
				SmallChange="5.0" LargeChange="20.0"
				Minimum="5.0" Maximum="500"
				Value="{Binding AxisXSliderValue}"
				/>
			<TextBlock
				Grid.Row="0" Grid.Column="2" 
				Theme="{StaticResource Large}"
				HorizontalAlignment="Left"
				Text="{Binding AxisXString}"
				/>
			<!-- Second Row : Y Axis -->
			<TextBlock
				Grid.Row="1" Grid.Column="0" 
				Theme="{StaticResource Large}"
				HorizontalAlignment="Right"
				Text="{DynamicResource Workflow.Spotlight.Height}"
				/>
			<Slider 
				Grid.Row="1" Grid.Column="1" 
				TickFrequency="50" TickPlacement="BottomRight"
				SmallChange="5.0" LargeChange="20.0"
				Minimum="5.0" Maximum="500"
				Value="{Binding AxisYSliderValue}"
				/>
			<TextBlock
				Grid.Row="1" Grid.Column="2" 
				Theme="{StaticResource Large}"
				HorizontalAlignment="Left"
				Text="{Binding AxisYString}"
				/>
			<!-- Third Row: Rotation-->
			<TextBlock
				Grid.Row="2" Grid.Column="0" 
				Theme="{StaticResource Large}"
				HorizontalAlignment="Right"
				Text="{DynamicResource Workflow.Spotlight.Rotation}"
				/>
			<Slider 
				Grid.Row="2" Grid.Column="1" 
				TickFrequency="5.0" TickPlacement="BottomRight"
				SmallChange="1.0" LargeChange="5.0"
				Minimum="-45.0" Maximum="45.0"
				Value="{Binding RotationSliderValue}"
				/>
			<TextBlock
				Grid.Row="2" Grid.Column="2" 
				Theme="{StaticResource Large}"
				HorizontalAlignment="Left"
				Text="{Binding RotationString}"
				/>
		</Grid>
		<TextBlock
			Grid.Row="5" 
			Text="{DynamicResource Workflow.Spotlight.Style}"
			Theme="{StaticResource Large}"
			TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"
			/>
		<Grid
			Grid.Row="6" 
			> 
			<Grid.ColumnDefinitions> 
				<ColumnDefinition Width="100" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="70" />
			</Grid.ColumnDefinitions>
			<!-- Single Row: Lightness -->
			<TextBlock
				Grid.Row="0" Grid.Column="0" 
				Theme="{StaticResource Large}"
				HorizontalAlignment="Right"
				Text="{DynamicResource Workflow.Spotlight.Strength}"
				/>
			<Slider 
				Grid.Row="0" Grid.Column="1" 
				TickFrequency="0.1" TickPlacement="BottomRight"
				SmallChange="0.01" LargeChange="0.05"
				Minimum="-0.8" Maximum="0.8"
				Value="{Binding LightnessSliderValue}"
				/>
			<TextBlock
				Grid.Row="0" Grid.Column="2" 
				Theme="{StaticResource Large}"
				HorizontalAlignment="Left"
				Text="{Binding LightnessString}"
				/>
		</Grid>
	</Grid>
</UserControl>
