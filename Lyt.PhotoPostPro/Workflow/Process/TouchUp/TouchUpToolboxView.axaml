<UserControl 
	x:Class="Lyt.PhotoPostPro.Workflow.Process.TouchUp.TouchUpToolboxView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Process.TouchUp"
	x:DataType="vm:TouchUpToolboxViewModel" 

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="72"

	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"
	>	
	<Grid
		>
		<Grid.RowDefinitions>
			<RowDefinition Height="{StaticResource Size.PromptTwoLines}" /> <!-- Prompt Spot --> 
			<RowDefinition Height="{StaticResource Size.PromptThreeLines}" /> <!-- Prompt Patch --> 
			<RowDefinition Height="{StaticResource Size.OneSlider}" /> <!-- Diameter slider --> 
			<RowDefinition Height="{StaticResource Size.Spacer}" /> <!--Spacer --> 
			<RowDefinition Height="{StaticResource Size.WfNav}" /> <!-- Patch Button --> 
			<RowDefinition Height="{StaticResource Size.Spacer}" /> <!--Spacer --> 
			<RowDefinition Height="{StaticResource Size.PromptOneLine}" /> 
			<RowDefinition Height="{StaticResource Size.Spacer}" /> <!--Spacer --> 
		</Grid.RowDefinitions>
		<TextBlock
			Grid.Row="0" 
			Text="{DynamicResource Workflow.TouchUp.Click}"
			Theme="{StaticResource Large}"
			TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"
			/>
		<TextBlock
			Grid.Row="1" 
			Text="{DynamicResource Workflow.TouchUp.ShiftClick}"
			Theme="{StaticResource Large}"
			TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"
			/>
		<Grid
			Grid.Row="2" 
			> 
			<Grid.ColumnDefinitions> 
				<ColumnDefinition Width="100" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="70" />
			</Grid.ColumnDefinitions>
			<TextBlock
				Grid.Column="0" 
				Theme="{StaticResource Large}"
				HorizontalAlignment="Right"
				Text="{DynamicResource Workflow.TouchUp.SpotSize}"
				/>
			<Slider 
				Grid.Column="1" 
				TickFrequency="10" TickPlacement="BottomRight"
				SmallChange="1" LargeChange="5"
				Minimum="10.0" Maximum="150.0"
				Value="{Binding DiameterSliderValue}"
				/>
			<TextBlock
				Grid.Column="2" 
				Theme="{StaticResource Large}"
				HorizontalAlignment="Left"
				Text="{Binding DiameterString}"
				/>
		</Grid>
		<glyphs:GlyphButton
			Grid.Row="4" 
			Grid.Column="1" Grid.ColumnSpan="2"
			Style="{StaticResource ControlIconButton}"
			Layout="IconTextLeftSide"
			GlyphSource="arrow_export"
			Text="{DynamicResource Workflow.TouchUp.RunPatch}"
			Command="{Binding OnPatch}"
			Width="280"
	    	/>
		<TextBlock
			Grid.Row="6" 
			Text="{DynamicResource Workflow.TouchUp.Again}"
			Theme="{StaticResource Large}"
			TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"
			/>
	</Grid>
</UserControl>
