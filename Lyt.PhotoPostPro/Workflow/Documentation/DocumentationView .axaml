<UserControl
	x:Class="Lyt.PhotoPostPro.Workflow.Documentation.DocumentationView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Documentation"
	x:DataType="vm:DocumentationViewModel"

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:images="clr-namespace:Lyt.Avalonia.Controls.Images;assembly=Lyt.Avalonia.Controls"
	xmlns:local="using:Lyt.PhotoPostPro.Workflow.Documentation"
	xmlns:shared="clr-namespace:Lyt.PhotoPostPro.Workflow.Shared"
	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"
	xmlns:meta="clr-namespace:Lyt.PhotoPostPro.Panes.MetadataPane"

	Background="Transparent"
	>
	<Grid
		>
		<Grid.RowDefinitions>
			<RowDefinition Height="4" />
			<RowDefinition Height="*" />
			<RowDefinition Height="4" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="8" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="8" />
		</Grid.ColumnDefinitions>


		<Grid
			Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="3"
			IsVisible="{Binding DocumentIsOpened}"
			> 
			<!-- Nested into the grid to prevent 'conflict' bewteen VMs for IsOpened --> 
			<local:DocumentView
				DataContext="{Binding DocumentViewModel}"
				/>
		</Grid>

		<Button
			x:Name="OpenButton"
			Grid.Row="1" Grid.Column="1"
			IsVisible="{Binding !DocumentIsOpened}"
			Command="{Binding OnOpen}"
			MaxHeight="800" MaxWidth="800"
			>
			<Image 
				x:Name="OpenButtonImage"
				Margin="8"
				/>
		</Button>
	</Grid>
</UserControl>
