<UserControl 
	x:Class="Lyt.PhotoPostPro.Workflow.Documentation.DocPageView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Documentation"
	x:DataType="vm:DocPageViewModel" 

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="280"
	>
	<Grid
		HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
		>
		<Image
			Source="{Binding PageBitmap}"
			Stretch="Uniform"
			/>
	</Grid>
</UserControl>
