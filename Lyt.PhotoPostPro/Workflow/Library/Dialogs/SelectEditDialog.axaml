<UserControl
	x:Class="Lyt.PhotoPostPro.Workflow.Library.Dialogs.SelectEditDialog"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Library.Dialogs"
	x:DataType="vm:SelectEditDialogModel" 

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"
	xmlns:toggle="clr-namespace:Lyt.Avalonia.Controls.Toggle;assembly=Lyt.Avalonia.Controls"
	xmlns:progress="clr-namespace:Lyt.Avalonia.Controls.Progress;assembly=Lyt.Avalonia.Controls"
	xmlns:countdown="clr-namespace:Lyt.Avalonia.Controls.Countdown;assembly=Lyt.Avalonia.Controls"
	>
	<Grid
		Width="720" Height="460"
		Background="Transparent"
		>
		<Rectangle
			Fill="#C0000020"
			Grid.ColumnSpan="999" Grid.RowSpan="999"
			RadiusX="4" RadiusY="4"
			Margin="1"
			/>
		<Border
			Margin ="1"
			BorderThickness="1.0"
			BorderBrush="{StaticResource ResourceKey= LightAqua_2_100}"
			Background="Transparent"
			>
			<Grid
				>
				<Grid.RowDefinitions>
					<RowDefinition Height="4"/>
					<RowDefinition Height="68"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>
				<Rectangle
					Grid.Row="0"
					VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
					Fill="{StaticResource ResourceKey= OrangePeel_2_080}"
					/>
				<Rectangle
					Grid.Row="1"
					VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
					Fill="#60202040"
					/>
				<Rectangle
					Grid.Row="1"
					Height="1"
					VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
					Fill="#F0302070"
					/>
				<TextBlock
					Grid.Row="1" Grid.Column="0"
					Text="{Binding Title}"
					HorizontalAlignment="Left" VerticalAlignment="Center"
					Margin="20 -4 0 0"
					FontSize="26"
					Foreground="{StaticResource LightAqua_0_080}"
					TextWrapping="Wrap"
					/>
				<!--Toolbar -->
				<Grid
					Grid.Row="1"
					HorizontalAlignment="Right" VerticalAlignment="Center"
					Margin="0 0 12 0"
					>
					<Grid.ColumnDefinitions>
						<!-- Ring  -->
						<ColumnDefinition Width="72" />
						<!-- Spacer -->
						<ColumnDefinition Width="40" />
						<!-- Dismiss -->
						<ColumnDefinition Width="80" />
					</Grid.ColumnDefinitions>
					<glyphs:GlyphButton
						Grid.Column="2"
						Style="{StaticResource AppToolbarIconButton}"
						Margin="2"
						GlyphSource="dismiss"
						GlyphStrokeThickness="0"
						Text="{DynamicResource Shell.Cancel}"
						Command="{Binding OnCancel}"
						/>
				</Grid>

				<!--Content -->
				<Grid
					x:Name="InnerGrid"
					Grid.Row="2"
					ShowGridLines="False"
					>
					<Grid.ColumnDefinitions> 
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="16"/>
						<RowDefinition Height="100"/> <!-- Message -->  
						<RowDefinition Height="90"/> <!-- Combo -->  
						<RowDefinition Height="90"/> <!-- Checkbox -->  
						<RowDefinition Height="90"/> <!-- Buttons -->  
						<RowDefinition Height="4"/> <!-- Spacer -->  
					</Grid.RowDefinitions>
					<TextBlock
						Text="{Binding Message}"
						Grid.Row="1" Grid.ColumnSpan="2"
						HorizontalAlignment="Left" VerticalAlignment="Top"
						Margin="20 0 20 0"
						Foreground="{StaticResource LightAqua_0_080}"
						FontSize="20"
						TextWrapping="Wrap"
						/>
					<ComboBox
						Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
						VerticalAlignment="Center" HorizontalAlignment="Left"
						Margin="20 0 0 0"
						ItemsSource="{Binding ParametersStrings}"
						SelectedIndex="{Binding SelectedParametersIndex, Mode=TwoWay}"
						Width="680" Height="54" MaxDropDownHeight="480"
						>
						<ComboBox.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Vertical"/>
							</ItemsPanelTemplate>
						</ComboBox.ItemsPanel>
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock 
									Text="{Binding}"
									Foreground="{StaticResource LightAqua_0_100}" 
									FontSize="20"
									/>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<LayoutTransformControl
						Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
						VerticalAlignment="Center" HorizontalAlignment="Left"
						Margin="20 0 0 0"
						>
						<LayoutTransformControl.LayoutTransform>
							<ScaleTransform ScaleX="1.5" ScaleY="1.5" />
						</LayoutTransformControl.LayoutTransform>
						<CheckBox
							IsChecked="{Binding IsReplayMode, Mode=TwoWay}"
							IsThreeState="False"
							>
							<CheckBox.Content>
								<TextBlock 
									Text="{Binding ShouldReplay}"
									Foreground="{StaticResource LightAqua_0_100}" 
									FontSize="13"
									TextWrapping="Wrap"
									/>
							</CheckBox.Content>
						</CheckBox>
					</LayoutTransformControl>					
					<glyphs:GlyphButton
						x:Name="StartOverButton"
						Style="{StaticResource ViewIconButton}"
						Grid.Row="4" Grid.Column="0"
						FontSize="24"
						HorizontalAlignment="Center" VerticalAlignment="Center"
						Width="330" Height="54"
						GlyphSource="wand"
						ButtonBackground="BorderlessRectangle"
						GlyphStrokeThickness="0"
						Text="{DynamicResource Library.StartOver}"
						Command="{Binding OnStartOver}"
	    				/>
					<glyphs:GlyphButton
						x:Name="ContinueButton"
						Grid.Row="4" Grid.Column="1"
						Style="{StaticResource ViewIconButton}"
						FontSize="24"
						HorizontalAlignment="Center" VerticalAlignment="Center"
						Width="330" Height="54"
						GlyphSource="arrow_export"
						ButtonBackground="BorderlessRectangle"
						GlyphStrokeThickness="0"
						Text="{DynamicResource Library.ContinueEdit}"
						Command="{Binding OnContinue}"
	    				/>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</UserControl>
