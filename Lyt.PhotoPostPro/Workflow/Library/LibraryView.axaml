<UserControl 
	x:Class="Lyt.PhotoPostPro.Workflow.Library.LibraryView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Library"
	x:DataType="vm:LibraryViewModel" 
	
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:shared="clr-namespace:Lyt.PhotoPostPro.Workflow.Shared"
	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"
	xmlns:stars="clr-namespace:Lyt.Avalonia.Controls.StarRating;assembly=Lyt.Avalonia.Controls"
	xmlns:controls="clr-namespace:Lyt.PhotoPostPro.Controls"
	xmlns:metadatapane="using:Lyt.PhotoPostPro.Panes.MetadataPane"

	Background="Transparent"
	>
	<Grid		
		> 
		<Grid.RowDefinitions>
			<RowDefinition Height="60" />
			<RowDefinition Height="60" />
			<RowDefinition Height="60" />
			<RowDefinition Height="*" />
			<RowDefinition Height="4" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="8" />
			<ColumnDefinition Width="168" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="8" />
			<ColumnDefinition Width="520"/>
			<ColumnDefinition Width="8" />
		</Grid.ColumnDefinitions>

		<controls:VSelectorControl
			Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" 
			SelectorButtons="{Binding Options}"
			/>
		<controls:HSelectorControl
			Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3"
			SelectorButtons="{Binding Years}"
			/> 
		<controls:HSelectorControl
			Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
			SelectorButtons="{Binding Months}"
			/> 
		<controls:HSelectorControl
			Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"
			SelectorButtons="{Binding Days}"
			/> 

		<vm:LibraryThumbnailsPanelView
			Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
			DataContext="{Binding LibraryThumbnailsPanelViewModel}"
			/>
		<TextBlock
			Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
			IsVisible="{Binding IsCullTextVisible}"
			Margin="0 24 12 0"
			HorizontalAlignment="Right" VerticalAlignment="Top"
			Text="{DynamicResource Library.RateAndCullNothing}"
			Theme="{StaticResource H3}"
			/>
		<glyphs:GlyphButton
			x:Name="CullButton"
			Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
			IsVisible="{Binding IsCullButtonVisible}"
			Style="{StaticResource ViewIconButton}"
			FontSize="24"
			HorizontalAlignment="Right" VerticalAlignment="Top"
			Width="480" Height="56"
			Margin="0 8 12 0"
			GlyphSource="star"
			ButtonBackground="BorderlessRectangle"
			GlyphStrokeThickness="0"
			Text="{DynamicResource Library.RateAndCull}"
			Command="{Binding OnRateAndCull}"
	    	/>
		<StackPanel
			Grid.Row="3" Grid.Column="4"
			Margin="0 6 0 0"
			>
			<shared:SpinView
				DataContext="{Binding SpinViewModel}"
				/>
			<Image
				Source="{Binding SelectedThumbnail}"
				Margin="0"
				IsHitTestVisible="False"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="520"
				MaxHeight="380"
				/>
			<stars:RatingControl
				IsVisible="{Binding HasSelection}"
				Width="240" Height="32"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Margin="60 4 0 4"
				RatingValue="{Binding SelectionRating}"
				IsReadOnly="True"
				/>
			<glyphs:GlyphButton
				x:Name="ProcessButton"
				IsVisible="{Binding HasSelection}"
				Style="{StaticResource ViewIconButton}"
				FontSize="24"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="520" Height="56"
				Margin="0 4 0 12"
				GlyphSource="wand"
				ButtonBackground="BorderlessRectangle"
				GlyphStrokeThickness="0"
				Text="{DynamicResource Library.ProcessImage}"
				Command="{Binding OnProcess}"
	    		/>
			<glyphs:GlyphButton
				x:Name="RemoveButton"
				IsVisible="{Binding HasSelection}"
				Style="{StaticResource ViewIconButton}"
				FontSize="24"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="520" Height="56"
				Margin="0 0 0 4"
				GlyphSource="delete"
				ButtonBackground="BorderlessRectangle"
				GlyphStrokeThickness="0"
				Text="{DynamicResource Library.RemoveImage}"
				Command="{Binding OnRemove}"
	    		/>
			<metadatapane:MetadataView
				DataContext="{Binding SelectedThumnailMetadataViewModel}"
				HorizontalAlignment="Stretch" 
				Margin="0 0 0 4"
				/>
			<glyphs:GlyphButton
				IsVisible="{Binding HasSelection}"
				Style="{StaticResource ViewIconButton}"
				FontSize="24"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="520" Height="56"
				Margin="0 0 0 12"
				GlyphSource="folder_open"
				ButtonBackground="BorderlessRectangle"
				GlyphStrokeThickness="0"
				Text="{DynamicResource Library.Navigate}"
				Command="{Binding OnNavigate}"
	    	/>
		</StackPanel>
	</Grid>
</UserControl>
