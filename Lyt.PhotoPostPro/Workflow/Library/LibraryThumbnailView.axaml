<UserControl 
	x:Class="Lyt.PhotoPostPro.Workflow.Library.LibraryThumbnailView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Library"
	x:DataType="vm:LibraryThumbnailViewModel" 

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="280"

	xmlns:stars="using:Lyt.Avalonia.Controls.StarRating"
	>
	<Border
		x:Name="outerBorder"
		Height="{Binding BorderHeight}" 
		Background="Transparent"
		BorderBrush="{StaticResource LightAqua_1_100}"
		BorderThickness="1"
		CornerRadius="4"
		>
		<Grid
			Margin="6"
			>
			<Grid.RowDefinitions>
				<RowDefinition Height="26" />
				<RowDefinition Height="26" />
				<RowDefinition Height="200" />
				<RowDefinition Height="26" />
			</Grid.RowDefinitions>
			<TextBlock
				Grid.Row="0" 
				Text="{Binding Title}"
				Theme="{StaticResource Large}"
				HorizontalAlignment="Center"
				FontWeight="DemiBold"
				/>
			<TextBlock
				Grid.Row="1" 
				Text="{Binding MetadataString}"
				Theme="{StaticResource Medium}"
				HorizontalAlignment="Center"
				/>
			<Image
				Grid.Row="2"
				Source="{Binding Thumbnail}"
				Height="{Binding ImageHeight}" 
				IsHitTestVisible="False"
				VerticalAlignment="Center"
				/>
			<StackPanel
				Grid.Row="3" 
				Orientation="Horizontal"
				HorizontalAlignment="Center"
				>				
				<Viewbox
					Height="24" Width="82"
					>
					<stars:RatingControl
						HorizontalAlignment="Center" VerticalAlignment="Center"
						IsReadOnly="True"
						RatingValue="{Binding Rating}"
						/>
				</Viewbox>
				<TextBlock
					Text="{Binding Details}"
					Theme="{StaticResource Medium}"
					Margin="16 0 0 0"
					/>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
