<UserControl 
	x:Class="Lyt.PhotoPostPro.Workflow.Library.LibraryToolbarView"
	xmlns:vm="clr-namespace:Lyt.PhotoPostPro.Workflow.Library"
	x:DataType="vm:LibraryToolbarViewModel" 

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="72"
	>	
	<StackPanel
		Orientation="Horizontal"
		HorizontalAlignment="Right"
		>
		<StackPanel
			Orientation="Horizontal"
			HorizontalAlignment="Right"
			IsVisible="{Binding PhotoBookIsVisible}"
			>
			<TextBlock
				Theme="{StaticResource H3}"
				Text="{Binding PhotoBookInUse}"
				HorizontalAlignment="Left" VerticalAlignment="Center"
				FontWeight="Normal"
				Foreground="{StaticResource PastelOrchid_0_080}"
				/>
			<ComboBox
				IsEditable="False"
				Width="180" Height="40"
				Margin="8 0 50 0"
				VerticalAlignment="Center" HorizontalAlignment="Center"
				ItemsSource="{Binding AvailablePhotoBooks}"
				SelectedIndex="{Binding SelectedPhotoBookIndex}"
				>
				<ComboBox.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Vertical"/>
					</ItemsPanelTemplate>
				</ComboBox.ItemsPanel>
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock 
							Text="{Binding}" 
							Foreground="{StaticResource LightAqua_0_100}"
							FontSize="16"
							Margin="8 0 0 0"
							/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</StackPanel>

		<StackPanel
			Orientation="Horizontal"
			HorizontalAlignment="Right"
			IsVisible="{Binding LibraryIsVisible}"
			>
			<TextBlock
				Theme="{StaticResource H3}"
				Text="{Binding LibraryInUse}"
				HorizontalAlignment="Left" VerticalAlignment="Center"
				FontWeight="Normal"
				Foreground="{StaticResource PastelOrchid_0_080}"
				/>
			<ComboBox
				IsEditable="False"
				Width="180" Height="40"
				Margin="8 0 50 0"
				VerticalAlignment="Center" HorizontalAlignment="Center"
				ItemsSource="{Binding AvailableLibraries}"
				SelectedIndex="{Binding SelectedLibraryIndex}"
				>
				<ComboBox.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Vertical"/>
					</ItemsPanelTemplate>
				</ComboBox.ItemsPanel>
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock 
							Text="{Binding}" 
							Foreground="{StaticResource LightAqua_0_100}"
							FontSize="16"
							Margin="8 0 0 0"
							/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</StackPanel>
	</StackPanel>
</UserControl>