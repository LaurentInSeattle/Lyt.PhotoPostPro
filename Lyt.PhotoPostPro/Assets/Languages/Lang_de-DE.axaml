    <system:String x:Key="Settings.CleanupNow">Jetzt aufräumen</system:String>

    <system:String x:Key="Settings.ReminderTitle">Wichtige Erinnerung</system:String>

    <system:String x:Key="Settings.ReminderSubtitle">Einige wichtige Punkte, die Sie bei heruntergeladenen Bildern beachten sollten ...</system:String>

    <system:String x:Key="Settings.ReminderText">Wir empfehlen Ihnen, die heruntergeladenen Bilder nur als Hintergrundbild zu verwenden.  Für jede andere kommerzielle oder sonstige Nutzung wenden Sie sich bitte an den Urheberrechtsinhaber.</system:String>

    <system:String x:Key="Shared.FileErrorTitle">Dateisystemfehler.</system:String>

    <system:String x:Key="Shared.FileErrorText">Die Bilddatei konnte nicht gespeichert werden.</system:String>

</ResourceDictionary>
