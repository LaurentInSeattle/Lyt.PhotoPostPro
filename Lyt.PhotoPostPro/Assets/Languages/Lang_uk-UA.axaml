    <system:String x:Key="Workflow.Vignette.Strength">Міцність:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Title">Баланс білого</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Correction">Відкоригуйте колірну температуру автоматично або налаштуйте її вручну.</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualColorMatrix">Вручну - базова кольорова матриця (швидко)</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualOffset">T. Offset:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualTannerHelland">Інструкція - пряма колірна температура</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Kelvin">Т. Кельвін:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.AutoGrayWorld">Автоматично - Алгоритм «Сірий світ».</system:String>

    <system:String x:Key="Workflow.WhiteBalance.AutoGrayWorldSaturation">насиченість:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.NoteGrayWorld">Примітка. Алгоритм «Сірий світ» добре працює ТІЛЬКИ на зображеннях, які мають багато різноманітних кольорів.</system:String>

    <system:String x:Key="Workflow.WhiteBalance.WhitePatch">Напівавтоматичний - Алгоритм «білої плями».</system:String>

    <system:String x:Key="Workflow.WhiteBalance.RunWhitePatch">Запустіть White Patch</system:String>

    <system:String x:Key="Workflow.WhiteBalance.NoteWhitePatch">Клацніть на яскравій ділянці на вихідному зображенні, яка має бути білою або безбарвною, а потім запустіть алгоритм.</system:String>

    <system:String x:Key="Workflow.Contrast.Title">Регулювання контрастності</system:String>

    <system:String x:Key="Workflow.Contrast.Correction">Виправте контраст глобально або використовуйте S-криві на кожному каналі RGB.</system:String>

    <system:String x:Key="Workflow.Contrast.Global">Глобальне коригування</system:String>

    <system:String x:Key="Workflow.Contrast.ContrastAmount">Контраст:</system:String>

