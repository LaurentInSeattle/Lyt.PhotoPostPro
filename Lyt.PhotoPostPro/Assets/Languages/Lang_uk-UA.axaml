    <system:String x:Key="Workflow.Lut.NoLut">Відхилити, немає LUT</system:String>

    <system:String x:Key="Workflow.Color.Title">Ручна градація кольорів</system:String>

    <system:String x:Key="Workflow.Color.Correction">Змініть інтенсивність кольору глобально або використовуйте Vibrance на кожному каналі RGB.</system:String>

