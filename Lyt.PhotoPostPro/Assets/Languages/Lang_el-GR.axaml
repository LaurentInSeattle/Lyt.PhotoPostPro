    <system:String x:Key="Workflow.Filters.Correction">Εφαρμόστε ειδικά εφέ στην εικόνα.</system:String>

    <system:String x:Key="Workflow.Filters.ExplainAmount">Για κλίμακα του γκρι ή σέπια:</system:String>

    <system:String x:Key="Workflow.Filters.Amount">Ποσό:</system:String>

