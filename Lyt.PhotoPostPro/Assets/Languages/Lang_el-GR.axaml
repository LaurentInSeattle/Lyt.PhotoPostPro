    <system:String x:Key="Workflow.Exposure.Title">Παγκόσμια Έκθεση</system:String>

    <system:String x:Key="Workflow.Exposure.Correction">Μπορείτε να διορθώσετε με οποιαδήποτε ή και τις τρεις μεθόδους συνδυαστικά: διόρθωση γάμμα, πολλαπλασιαστικό κέρδος ή πρόσθετη μετατόπιση φωτεινότητας.</system:String>

    <system:String x:Key="Workflow.Exposure.Clear">Επαναφορά</system:String>

    <system:String x:Key="Workflow.Exposure.Gamma">Γάμμα:</system:String>

    <system:String x:Key="Workflow.Exposure.Gain">Κέρδος:</system:String>

    <system:String x:Key="Workflow.Exposure.Shift">Αλλαγή:</system:String>

    <system:String x:Key="Workflow.Recovery.Title">Στιγμιότυπα και σκιές</system:String>

    <system:String x:Key="Workflow.Recovery.Correction">Ένας μη γραμμικός αλγόριθμος φωτεινότητας για την αποκάλυψη και την ανάκτηση λεπτομερειών στην εικόνα.</system:String>

    <system:String x:Key="Workflow.Recovery.Clear">Επαναφορά</system:String>

    <system:String x:Key="Workflow.Recovery.Highlights">Ανταύγειες:</system:String>

    <system:String x:Key="Workflow.Recovery.Shadows">Σκιές:</system:String>

    <system:String x:Key="Workflow.Vignette.Title">Επιλεκτική διόρθωση έκθεσης</system:String>

    <system:String x:Key="Workflow.Vignette.Correction">Εφαρμόστε διόρθωση έκθεσης σε επιλεγμένες πλευρές της εικόνας.</system:String>

    <system:String x:Key="Workflow.Vignette.Sides">Πλευρές:</system:String>

    <system:String x:Key="Workflow.Vignette.Top">Κορυφή:</system:String>

    <system:String x:Key="Workflow.Vignette.Bottom">Κάτω μέρος:</system:String>

    <system:String x:Key="Workflow.Vignette.Left">Αριστερά:</system:String>

    <system:String x:Key="Workflow.Vignette.Right">Δικαίωμα</system:String>

    <system:String x:Key="Workflow.Vignette.Style">Διόρθωση σκούρου ή φωτός:</system:String>

    <system:String x:Key="Workflow.Vignette.Strength">Δύναμη:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Title">Ισορροπία λευκού</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Correction">Διορθώστε τη θερμοκρασία χρώματος αυτόματα ή προσαρμόστε τη χειροκίνητα.</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualColorMatrix">Εγχειρίδιο - Basic Color Matrix (γρήγορο)</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualOffset">T. Offset:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualTannerHelland">Εγχειρίδιο - Άμεση θερμοκρασία χρώματος</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Kelvin">Τ. Κέλβιν:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.AutoGrayWorld">Αυτόματος - Αλγόριθμος «Γκρι Κόσμος».</system:String>

    <system:String x:Key="Workflow.WhiteBalance.AutoGrayWorldSaturation">Κορεσμός:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.NoteGrayWorld">Σημείωση: Ο αλγόριθμος "Gray World" λειτουργεί καλά ΜΟΝΟ σε εικόνες που έχουν πολλά διαφορετικά χρώματα.</system:String>

    <system:String x:Key="Workflow.WhiteBalance.WhitePatch">Ημιαυτόματο - Αλγόριθμος «Λευκό μπαλώματα».</system:String>

    <system:String x:Key="Workflow.WhiteBalance.RunWhitePatch">Εκτελέστε το White Patch</system:String>

    <system:String x:Key="Workflow.WhiteBalance.NoteWhitePatch">Κάντε κλικ σε μια φωτεινή περιοχή στην εικόνα Πηγή που πρέπει να είναι λευκή ή άχρωμη και, στη συνέχεια, εκτελέστε τον αλγόριθμο.</system:String>

    <system:String x:Key="Workflow.Contrast.Title">Προσαρμογή αντίθεσης</system:String>

    <system:String x:Key="Workflow.Contrast.Correction">Διορθώστε την αντίθεση καθολικά ή χρησιμοποιήστε S-Curves σε κάθε κανάλι RGB.</system:String>

    <system:String x:Key="Workflow.Contrast.Global">Παγκόσμια προσαρμογή</system:String>

    <system:String x:Key="Workflow.Contrast.ContrastAmount">Αντίθεση:</system:String>

    <system:String x:Key="Workflow.Contrast.BlurAmount">Blur Sigma:</system:String>

    <system:String x:Key="Workflow.Contrast.BrightnessAmount">Λάμψη:</system:String>

    <system:String x:Key="Workflow.Contrast.SCurves">S-Curves</system:String>

    <system:String x:Key="Workflow.Lut.Title">Διαβάθμιση χρώματος πίνακα αναζήτησης</system:String>

    <system:String x:Key="Workflow.Lut.Correction">Χρησιμοποιήστε έναν Πίνακα αναζήτησης για να προσαρμόσετε τα χρώματα και να προσθέσετε κάποιο ιδιαίτερο «vibe» στην εικόνα.</system:String>

    <system:String x:Key="Workflow.Lut.UseLut">Επιλέξτε έναν προκαθορισμένο πίνακα αναζήτησης:</system:String>

    <system:String x:Key="Workflow.Lut.None">-- -- Κανένα --</system:String>

    <system:String x:Key="Workflow.Lut.DropLut">Ή... Χρησιμοποιήστε το αρχείο .cube ή 3DL:</system:String>

    <system:String x:Key="Workflow.Lut.DragDropHelp">Σύρετε και αποθέστε εδώ ένα αρχείο .cube ή 3dl!</system:String>

    <system:String x:Key="Workflow.Color.Title">Χειροκίνητη ταξινόμηση χρωμάτων</system:String>

    <system:String x:Key="Workflow.Color.Correction">Αναβαθμίστε την ένταση χρώματος παγκοσμίως ή χρησιμοποιήστε το Vibrance σε κάθε κανάλι RGB.</system:String>

    <system:String x:Key="Workflow.Color.Global">Παγκόσμια προσαρμογή</system:String>

    <system:String x:Key="Workflow.Color.SaturationAmount">Κορεσμός:</system:String>

    <system:String x:Key="Workflow.Color.Vibrance">Δόνηση</system:String>

