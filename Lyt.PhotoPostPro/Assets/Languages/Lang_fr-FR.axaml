    <system:String x:Key="Workflow.Orient.Format">Restaurer le format portrait ou paysage :</system:String>

    <system:String x:Key="Workflow.Orient.Flip">Retournez l'image si nécessaire :</system:String>

    <system:String x:Key="Workflow.Orient.RotateMinus">- 90°</system:String>

    <system:String x:Key="Workflow.Orient.RotatePlus">+90°</system:String>

    <system:String x:Key="Workflow.Orient.Mirror">Miroir</system:String>

    <system:String x:Key="Workflow.Orient.Reverse">Retourner</system:String>

    <system:String x:Key="Workflow.Straighten.Title">Redresser l'image</system:String>

    <system:String x:Key="Workflow.Straighten.Guidelines">Afficher ou masquer les guides d'alignement :</system:String>

    <system:String x:Key="Workflow.Straighten.VerticalGuideline">Verticale</system:String>

    <system:String x:Key="Workflow.Straighten.HorizontalGuideline">Horizontal</system:String>

    <system:String x:Key="Workflow.Straighten.Rotate">Faites pivoter pour ajuster l'alignement :</system:String>

