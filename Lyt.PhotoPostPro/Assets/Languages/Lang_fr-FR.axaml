    <system:String x:Key="Workflow.Straighten.RotatePlusMedium">+0,5°</system:String>

    <system:String x:Key="Workflow.Straighten.RotateMinusSmall">- 0,1°</system:String>

    <system:String x:Key="Workflow.Straighten.RotatePlusSmall">+ 0,1°</system:String>

    <system:String x:Key="Workflow.Compose.Title">Affiner la composition</system:String>

    <system:String x:Key="Workflow.Compose.Croplines">Lignes de coupe :</system:String>

    <system:String x:Key="Workflow.Compose.Clear">Réinitialiser</system:String>

    <system:String x:Key="Workflow.Compose.Preview">Aperçu</system:String>

    <system:String x:Key="Workflow.Compose.Top">Haut:</system:String>

    <system:String x:Key="Workflow.Compose.Bottom">Bas:</system:String>

    <system:String x:Key="Workflow.Compose.Left">Gauche:</system:String>

    <system:String x:Key="Workflow.Compose.Right">Droite:</system:String>

    <system:String x:Key="Workflow.Compose.Width">Largeur:</system:String>

    <system:String x:Key="Workflow.Compose.Height">Hauteur:</system:String>

    <system:String x:Key="Workflow.Compose.AspectRatio">Rapport hauteur/largeur :</system:String>

    <system:String x:Key="Workflow.Compose.CompositionGuides">Sélectionnez un guide de composition :</system:String>

    <system:String x:Key="Workflow.Compose.CG.None">- - Aucun - -</system:String>

    <system:String x:Key="Workflow.Compose.CG.Thirds">Règle des tiers</system:String>

    <system:String x:Key="Workflow.Compose.CG.Frame">Cadre</system:String>

    <system:String x:Key="Workflow.Compose.CG.Halves">Lignes médianes</system:String>

    <system:String x:Key="Workflow.Compose.CG.Diagonals">Diagonales</system:String>

    <system:String x:Key="Workflow.Compose.CG.GoldenUp">Triangles d'or vers le haut</system:String>

    <system:String x:Key="Workflow.Compose.CG.GoldenDown">Triangles d'or vers le bas</system:String>

    <system:String x:Key="Workflow.Exposure.Title">Exposition mondiale</system:String>

    <system:String x:Key="Workflow.Exposure.Correction">Vous pouvez corriger avec l'une ou les trois méthodes combinées : correction gamma, gain multiplicatif ou changement de luminosité additif.</system:String>

    <system:String x:Key="Workflow.Exposure.Clear">Réinitialiser</system:String>

    <system:String x:Key="Workflow.Exposure.Gamma">Gamma:</system:String>

    <system:String x:Key="Workflow.Exposure.Gain">Gagner:</system:String>

    <system:String x:Key="Workflow.Exposure.Shift">Changement:</system:String>

    <system:String x:Key="Workflow.Recovery.Title">Faits saillants et ombres</system:String>

    <system:String x:Key="Workflow.Recovery.Correction">Un algorithme de luminance non linéaire pour révéler et récupérer les détails de l'image.</system:String>

    <system:String x:Key="Workflow.Recovery.Clear">Réinitialiser</system:String>

    <system:String x:Key="Workflow.Recovery.Highlights">Points forts:</system:String>

    <system:String x:Key="Workflow.Recovery.Shadows">Ombres :</system:String>

    <system:String x:Key="Workflow.Vignette.Title">Correction d'exposition sélective</system:String>

    <system:String x:Key="Workflow.Vignette.Correction">Appliquez une correction d’exposition aux côtés sélectionnés de l’image.</system:String>

    <system:String x:Key="Workflow.Vignette.Sides">Côtés :</system:String>

    <system:String x:Key="Workflow.Vignette.Top">Haut:</system:String>

    <system:String x:Key="Workflow.Vignette.Bottom">Bas:</system:String>

    <system:String x:Key="Workflow.Vignette.Left">Gauche:</system:String>

    <system:String x:Key="Workflow.Vignette.Right">Droite</system:String>

    <system:String x:Key="Workflow.Vignette.Style">Correction sombre ou claire :</system:String>

    <system:String x:Key="Workflow.Vignette.Strength">Force:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Title">Balance des blancs</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Correction">Corrigez automatiquement la température de couleur ou ajustez-la manuellement.</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualColorMatrix">Manuel - Matrice de couleurs de base (rapide)</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualOffset">T. Décalage :</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualTannerHelland">Manuel - Température de couleur directe</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Kelvin">T. Kelvin :</system:String>

    <system:String x:Key="Workflow.WhiteBalance.AutoGrayWorld">Automatique - Algorithme « Monde Gris »</system:String>

    <system:String x:Key="Workflow.WhiteBalance.AutoGrayWorldSaturation">Saturation:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.NoteGrayWorld">Remarque : L'algorithme « Monde gris » fonctionne bien UNIQUEMENT sur les images comportant de nombreuses couleurs différentes.</system:String>

    <system:String x:Key="Workflow.WhiteBalance.WhitePatch">Semi-automatique - Algorithme 'White Patch'</system:String>

    <system:String x:Key="Workflow.WhiteBalance.RunWhitePatch">Exécuter le patch blanc</system:String>

    <system:String x:Key="Workflow.WhiteBalance.NoteWhitePatch">Cliquez sur une zone lumineuse de l'image source qui doit être blanche ou incolore, puis exécutez l'algorithme.</system:String>

    <system:String x:Key="Workflow.Contrast.Title">Réglage du contraste</system:String>

    <system:String x:Key="Workflow.Contrast.Correction">Corrigez le contraste globalement ou utilisez des courbes en S sur chaque canal RVB.</system:String>

    <system:String x:Key="Workflow.Contrast.Global">Ajustement global</system:String>

    <system:String x:Key="Workflow.Contrast.ContrastAmount">Contraste:</system:String>

    <system:String x:Key="Workflow.Contrast.BlurAmount">Flou Sigma :</system:String>

    <system:String x:Key="Workflow.Contrast.BrightnessAmount">Luminosité:</system:String>

    <system:String x:Key="Workflow.Contrast.SCurves">Courbes en S</system:String>

    <system:String x:Key="Workflow.Lut.Title">Classement des couleurs de la table de recherche</system:String>

    <system:String x:Key="Workflow.Lut.Correction">Utilisez une table de recherche pour ajuster les couleurs et ajouter une « ambiance » spéciale à l’image.</system:String>

    <system:String x:Key="Workflow.Lut.UseLut">Choisissez une table de recherche prédéfinie :</system:String>

    <system:String x:Key="Workflow.Lut.None">- - Aucun - -</system:String>

    <system:String x:Key="Workflow.Lut.DropLut">Ou... Utilisez votre fichier .cube ou 3DL :</system:String>

    <system:String x:Key="Workflow.Lut.DragDropHelp">Glissez et déposez ici un fichier .cube ou 3dl !</system:String>

    <system:String x:Key="Workflow.Color.Title">Étalonnage manuel des couleurs</system:String>

    <system:String x:Key="Workflow.Color.Correction">Regradez l’intensité des couleurs globalement ou utilisez Vibrance sur chaque canal RVB.</system:String>

    <system:String x:Key="Workflow.Color.Global">Ajustement global</system:String>

    <system:String x:Key="Workflow.Color.SaturationAmount">Saturation:</system:String>

    <system:String x:Key="Workflow.Color.Vibrance">Vibrance</system:String>

    <system:String x:Key="Workflow.Color.Red">Rouge:</system:String>

    <system:String x:Key="Workflow.Color.Green">Vert:</system:String>

    <system:String x:Key="Workflow.Color.Blue">Bleu:</system:String>

    <system:String x:Key="Workflow.Sharpen.Title">Aiguiser</system:String>

    <system:String x:Key="Workflow.Sharpen.Correction">Augmente le contraste local le long des bords des objets dans l'image.</system:String>

    <system:String x:Key="Workflow.Sharpen.Global">Ajustement global</system:String>

    <system:String x:Key="Workflow.Sharpen.BlurAmount">Sigma :</system:String>

    <system:String x:Key="Workflow.Sharpen.Note">Remarque : un affûtage excessif peut être préjudiciable.  Il peut introduire des « halos » visibles le long des bords et amplifier le bruit numérique.</system:String>

    <system:String x:Key="Workflow.Filters.Title">Filtres spéciaux</system:String>

    <system:String x:Key="Workflow.Filters.Correction">Appliquez des effets spéciaux à l'image.</system:String>

