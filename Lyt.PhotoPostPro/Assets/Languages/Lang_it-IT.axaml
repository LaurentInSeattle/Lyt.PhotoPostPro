    <system:String x:Key="Workflow.Recovery.Clear">Reset</system:String>

    <system:String x:Key="Workflow.Recovery.Highlights">Luci:</system:String>

    <system:String x:Key="Workflow.Recovery.Shadows">Ombre:</system:String>

