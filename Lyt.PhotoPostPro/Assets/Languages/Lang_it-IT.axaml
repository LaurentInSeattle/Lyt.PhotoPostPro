    <system:String x:Key="Dialog.ConfirmRemove.Title">Rimuovere dalla Raccolta ?</system:String>

    <system:String x:Key="Dialog.ConfirmRemove.Message">Questa immagine master e tutti i dati allegati, come miniature e registri delle modifiche, verranno eliminati.&#xD;&#xA;&#xD;&#xA;Tutti i file verranno spostati nel Cestino.&#xD;&#xA;&#xD;&#xA;Questa operazione non può essere annullata.</system:String>

    <system:String x:Key="Dialog.SelectEdit.Title">Ricominciare o continuare?</system:String>

    <system:String x:Key="Dialog.SelectEdit.Message">Questa immagine è già stata modificata.  Vuoi ricominciare da capo o utilizzare le impostazioni precedenti?&#xD;&#xA;&#xD;&#xA;In tal caso, seleziona le impostazioni aggiornate in precedenza nella casella combinata in basso e fai clic su "Continua".&#xD;&#xA;&#xD;&#xA;In caso contrario, fai semplicemente clic su "Ricomincia".</system:String>

    <system:String x:Key="Dialog.SelectEdit.LastUpdatedFmt">Ultimo aggiornamento: {0} alle: {1}</system:String>

    <system:String x:Key="Intro.AgreeMIT">Accetto i termini della licenza MIT, Continua.</system:String>

    <system:String x:Key="Intro.LicenseTitle">Termini di licenza.</system:String>

    <system:String x:Key="Intro.LicenseSubtitle">Questa applicazione vi viene fornita secondo i termini della licenza MIT.</system:String>

    <system:String x:Key="Intro.LicenseTerms">Questa applicazione vi viene fornita secondo i termini della licenza MIT e pertanto, unitamente ad altri termini, non implica alcuna garanzia di alcun tipo. Utilizzando questa applicazione software, accettate pienamente i termini e le condizioni della licenza MIT.</system:String>

    <system:String x:Key="Intro.ReminderTitle">Promemoria importante...</system:String>

