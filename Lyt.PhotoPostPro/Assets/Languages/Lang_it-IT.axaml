    <system:String x:Key="Workflow.WhiteBalance.Title">Bilanciamento del Bianco</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Correction">Correggere automaticamente la temperatura del colore o regolarla manualmente.</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualColorMatrix">Manuale - Matrice colori di base</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualOffset">Scostamento T.:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualTannerHelland">Manuale - Temperatura colore diretta</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Kelvin">T. Kelvin:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.AutoGrayWorld">Automatico: Algoritmo "Mondo Grigio".</system:String>

    <system:String x:Key="Workflow.WhiteBalance.AutoGrayWorldSaturation">Saturazione:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.NoteGrayWorld">Nota: l'algoritmo 'Mondo Grigio' funziona bene SOLO su immagini che contengono molti colori diversi.</system:String>

    <system:String x:Key="Workflow.WhiteBalance.WhitePatch">Semiautomatico: algoritmo "White Patch".</system:String>

    <system:String x:Key="Workflow.WhiteBalance.RunWhitePatch">Esegui la patch bianca</system:String>

    <system:String x:Key="Workflow.WhiteBalance.NoteWhitePatch">Fare clic su un'area luminosa dell'immagine sorgente che dovrebbe essere bianca o incolore, quindi eseguire l'algoritmo.</system:String>

