    <system:String x:Key="Workflow.Exposure.Title">Esposizione Globale</system:String>

    <system:String x:Key="Workflow.Exposure.Correction">È possibile correggere con uno qualsiasi o tutti e tre i metodi combinati: correzione gamma, guadagno moltiplicativo o spostamento additivo della luminosità.</system:String>

    <system:String x:Key="Workflow.Exposure.Clear">Reset</system:String>

