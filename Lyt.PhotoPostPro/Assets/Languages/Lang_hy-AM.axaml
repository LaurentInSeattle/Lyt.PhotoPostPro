    <system:String x:Key="Workflow.Exposure.Shift">Shift:</system:String>

    <system:String x:Key="Workflow.Recovery.Title">Առանձնահատկություններ և ստվերներ</system:String>

    <system:String x:Key="Workflow.Recovery.Correction">Լուսավորության ոչ գծային ալգորիթմ՝ պատկերի մանրամասները բացահայտելու և վերականգնելու համար:</system:String>

    <system:String x:Key="Workflow.Recovery.Clear">Վերականգնել</system:String>

    <system:String x:Key="Workflow.Recovery.Highlights">Առանձնահատկություններ.</system:String>

    <system:String x:Key="Workflow.Recovery.Shadows">Ստվերներ:</system:String>

    <system:String x:Key="Workflow.Vignette.Title">Ընտրովի ազդեցության ուղղում</system:String>

    <system:String x:Key="Workflow.Vignette.Correction">Կիրառեք լուսարձակման ուղղում պատկերի ընտրված կողմերին:</system:String>

    <system:String x:Key="Workflow.Vignette.Sides">Կողմերը:</system:String>

    <system:String x:Key="Workflow.Vignette.Top">Վերև:</system:String>

    <system:String x:Key="Workflow.Vignette.Bottom">Ստորին:</system:String>

    <system:String x:Key="Workflow.Vignette.Left">Ձախ՝</system:String>

    <system:String x:Key="Workflow.Vignette.Right">Ճիշտ է</system:String>

    <system:String x:Key="Workflow.Vignette.Style">Մութ կամ թեթև ուղղում.</system:String>

    <system:String x:Key="Workflow.Vignette.Strength">Ուժ:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Title">Սպիտակ հավասարակշռություն</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Correction">Ուղղեք գույնի ջերմաստիճանը ավտոմատ կերպով կամ կարգավորեք այն ձեռքով:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualColorMatrix">Ձեռնարկ - Հիմնական գունային մատրիցա (արագ)</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualOffset">T. Օֆսեթ:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualTannerHelland">Ձեռնարկ - ուղղակի գույնի ջերմաստիճան</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Kelvin">T. Kelvin:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.AutoGrayWorld">Ավտոմատ - «Գորշ աշխարհ» ալգորիթմ</system:String>

    <system:String x:Key="Workflow.WhiteBalance.AutoGrayWorldSaturation">Հագեցվածություն:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.NoteGrayWorld">Նշում. «Գորշ աշխարհ» ալգորիթմը լավ է աշխատում ՄԻԱՅՆ պատկերների վրա, որոնք ունեն շատ տարբեր գույներ:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.WhitePatch">Կիսաավտոմատ - «Սպիտակ կարկատան» ալգորիթմ</system:String>

    <system:String x:Key="Workflow.WhiteBalance.RunWhitePatch">Գործարկել White Patch-ը</system:String>

    <system:String x:Key="Workflow.WhiteBalance.NoteWhitePatch">Կտտացրեք Աղբյուրի պատկերի պայծառ տարածքի վրա, որը պետք է լինի սպիտակ կամ անգույն, ապա գործարկեք ալգորիթմը:</system:String>

    <system:String x:Key="Workflow.Contrast.Title">Կոնտրաստի ճշգրտում</system:String>

    <system:String x:Key="Workflow.Contrast.Correction">Ուղղեք գլոբալ հակադրությունը կամ օգտագործեք S-Curves յուրաքանչյուր RGB ալիքի վրա:</system:String>

    <system:String x:Key="Workflow.Contrast.Global">Համաշխարհային ճշգրտում</system:String>

    <system:String x:Key="Workflow.Contrast.ContrastAmount">Հակադրություն:</system:String>

    <system:String x:Key="Workflow.Contrast.BlurAmount">Blur Sigma:</system:String>

    <system:String x:Key="Workflow.Contrast.BrightnessAmount">Պայծառություն:</system:String>

    <system:String x:Key="Workflow.Contrast.SCurves">S-կորեր</system:String>

    <system:String x:Key="Workflow.Lut.Title">Որոնման աղյուսակի գույների դասակարգում</system:String>

    <system:String x:Key="Workflow.Lut.Correction">Օգտագործեք Փնտրման աղյուսակը՝ գույները կարգավորելու և պատկերին հատուկ «վիբ» ավելացնելու համար:</system:String>

    <system:String x:Key="Workflow.Lut.UseLut">Ընտրեք նախապես սահմանված որոնման աղյուսակ.</system:String>

    <system:String x:Key="Workflow.Lut.None">- - Ոչ - -</system:String>

    <system:String x:Key="Workflow.Lut.DropLut">Կամ... Օգտագործեք ձեր .cube կամ 3DL ֆայլը՝</system:String>

    <system:String x:Key="Workflow.Lut.DragDropHelp">Քաշեք և թողեք այստեղ .cube կամ 3dl ֆայլ:</system:String>

    <system:String x:Key="Workflow.Color.Title">Ձեռքով գույնի դասակարգում</system:String>

    <system:String x:Key="Workflow.Color.Correction">Վերափոխեք գույնի ինտենսիվությունը ամբողջ աշխարհում կամ օգտագործեք Vibrance-ը յուրաքանչյուր RGB ալիքում:</system:String>

    <system:String x:Key="Workflow.Color.Global">Համաշխարհային ճշգրտում</system:String>

    <system:String x:Key="Workflow.Color.SaturationAmount">Հագեցվածություն:</system:String>

    <system:String x:Key="Workflow.Color.Vibrance">Կենսունակություն</system:String>

    <system:String x:Key="Workflow.Color.Red">Կարմիր:</system:String>

    <system:String x:Key="Workflow.Color.Green">Կանաչ:</system:String>

    <system:String x:Key="Workflow.Color.Blue">Կապույտ:</system:String>

    <system:String x:Key="Workflow.Sharpen.Title">Սրել</system:String>

    <system:String x:Key="Workflow.Sharpen.Correction">Բարձրացնում է տեղային հակադրությունը պատկերի առարկաների եզրերի երկայնքով:</system:String>

    <system:String x:Key="Workflow.Sharpen.Global">Համաշխարհային ճշգրտում</system:String>

    <system:String x:Key="Workflow.Sharpen.BlurAmount">Սիգմա:</system:String>

    <system:String x:Key="Workflow.Sharpen.Note">Նշում. չափից ավելի սրումը կարող է վնասակար լինել:  Այն կարող է ներկայացնել տեսանելի «հալոսներ» եզրերի երկայնքով և ուժեղացնել թվային աղմուկը:</system:String>

