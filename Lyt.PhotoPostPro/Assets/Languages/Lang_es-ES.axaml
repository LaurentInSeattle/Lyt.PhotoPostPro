    <system:String x:Key="Workflow.WhiteBalance.Title">Balance de blancos</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Correction">Corrija la temperatura del color automáticamente o ajústela manualmente.</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualColorMatrix">Manual - Matriz de colores básica (rápida)</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualOffset">T. Compensación:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualTannerHelland">Manual - Temperatura de color directa</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Kelvin">T.Kelvin:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.AutoGrayWorld">Automático: algoritmo del 'mundo gris'</system:String>

    <system:String x:Key="Workflow.WhiteBalance.AutoGrayWorldSaturation">Saturación:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.NoteGrayWorld">Nota: El algoritmo 'Mundo gris' funciona bien SÓLO en imágenes que tienen muchos colores diferentes.</system:String>

    <system:String x:Key="Workflow.WhiteBalance.WhitePatch">Semiautomático: algoritmo de 'parche blanco'</system:String>

