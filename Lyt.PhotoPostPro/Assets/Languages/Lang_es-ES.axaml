    <system:String x:Key="Dialog.ConfirmRemove.Title">¿Quitar de la biblioteca?</system:String>

    <system:String x:Key="Dialog.ConfirmRemove.Message">Esta imagen maestra y todos los datos adjuntos, como miniaturas y registros de edición, se eliminarán.&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;Todos los archivos se moverán a la Papelera de reciclaje.&#xD;&#xA;&#xD;&#xA;Esta operación no se puede deshacer.</system:String>

    <system:String x:Key="Dialog.SelectEdit.Title">¿Empezar de nuevo o continuar?</system:String>

    <system:String x:Key="Dialog.SelectEdit.Message">Esta imagen ya ha sido editada.  ¿Quieres empezar de nuevo o utilizar la configuración anterior?&#xD;&#xA;&#xD;&#xA;Si es así, seleccione la configuración actualizada previamente en el 'cuadro combinado a continuación y haga clic en 'Continuar'.&#xD;&#xA;&#xD;&#xA;De lo contrario, simplemente haga clic en "Comenzar de nuevo".</system:String>

    <system:String x:Key="Dialog.SelectEdit.LastUpdatedFmt">Última actualización: {0} en: {1}</system:String>

    <system:String x:Key="Intro.AgreeMIT">Acepto los términos de la Licencia MIT, Continuar.</system:String>

    <system:String x:Key="Intro.LicenseTitle">Términos de licencia</system:String>

    <system:String x:Key="Intro.LicenseSubtitle">Esta aplicación se le proporciona según los términos de la licencia MIT.</system:String>

    <system:String x:Key="Intro.LicenseTerms">Esta aplicación se le proporciona según los términos de la Licencia MIT y, junto con otros términos, no implica garantía de ningún tipo.  Al utilizar este software, acepta plenamente los términos y condiciones de la licencia MIT.</system:String>

    <system:String x:Key="Intro.ReminderTitle">Recordatorio importante</system:String>

    <system:String x:Key="Intro.ReminderSubtitle">Algunos puntos importantes para recordar sobre las imágenes descargadas...</system:String>

    <system:String x:Key="Intro.ReminderText">Se recomienda utilizar las imágenes descargadas sólo como fondo de pantalla.  Para cualquier otro uso, comercial o de otro tipo, comuníquese con el titular de los derechos de autor.</system:String>

