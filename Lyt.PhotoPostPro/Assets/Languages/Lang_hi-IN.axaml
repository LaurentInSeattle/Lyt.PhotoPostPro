    <system:String x:Key="Workflow.WhiteBalance.Title">श्वेत संतुलन</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Correction">रंग तापमान को स्वचालित रूप से ठीक करें या इसे मैन्युअल रूप से समायोजित करें।</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualColorMatrix">मैनुअल - मूल रंग मैट्रिक्स (तेज)</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualOffset">टी. ऑफसेट:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.ManualTannerHelland">मैनुअल - प्रत्यक्ष रंग तापमान</system:String>

    <system:String x:Key="Workflow.WhiteBalance.Kelvin">टी. केल्विन:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.AutoGrayWorld">स्वचालित - 'ग्रे वर्ल्ड' एल्गोरिथम</system:String>

    <system:String x:Key="Workflow.WhiteBalance.AutoGrayWorldSaturation">संतृप्ति:</system:String>

    <system:String x:Key="Workflow.WhiteBalance.NoteGrayWorld">ध्यान दें: 'ग्रे वर्ल्ड' एल्गोरिदम केवल उन छवियों पर अच्छा काम करता है जिनमें बहुत सारे विभिन्न रंग होते हैं।</system:String>

    <system:String x:Key="Workflow.WhiteBalance.WhitePatch">अर्ध-स्वचालित - 'व्हाइट पैच' एल्गोरिथम</system:String>

    <system:String x:Key="Workflow.WhiteBalance.RunWhitePatch">सफ़ेद पैच चलाएँ</system:String>

    <system:String x:Key="Workflow.WhiteBalance.NoteWhitePatch">स्रोत छवि पर एक उज्ज्वल क्षेत्र पर क्लिक करें जो सफेद या रंगहीन होना चाहिए, फिर एल्गोरिदम चलाएँ।</system:String>

    <system:String x:Key="Workflow.Contrast.Title">कंट्रास्ट समायोजन</system:String>

    <system:String x:Key="Workflow.Contrast.Correction">विश्व स्तर पर कंट्रास्ट को ठीक करें या प्रत्येक आरजीबी चैनल पर एस-कर्व का उपयोग करें।</system:String>

    <system:String x:Key="Workflow.Contrast.Global">वैश्विक समायोजन</system:String>

