<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
	<Border Padding="20"
			Background="Transparent"
			>
		<Slider
			Width="450" Height="64"
			Minimum="1" Maximum="12"
			Value="5"
			Orientation="Horizontal"
			IsSnapToTickEnabled="False"
			TickFrequency="1" TickPlacement="BottomRight"
			SmallChange="1" LargeChange="2"
			Foreground="{StaticResource LightAqua_1_100}"
			>
		</Slider>
	</Border>
  </Design.PreviewWith>

	<!-- Slider: horizontal --> 
	<Style Selector="Slider:horizontal">
		<Setter Property="Margin" Value="8 2 8 0" />
		<Setter Property="Height" Value="80" />
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
	</Style>
	
	<Style Selector="Slider:horizontal /template/ Thumb">
		<Setter Property="Width" Value="40"/>
		<Setter Property="Height" Value="40"/>
		<Setter Property="Foreground" Value="{StaticResource LightAqua_1_100}" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border
					Background="#20202020"
					>
					<Ellipse
						Width="18" Height="18"
						Fill="{StaticResource LightAqua_1_100}"
						/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
 
	<Style Selector="Slider:horizontal /template/ RepeatButton#PART_IncreaseButton">
		<Setter Property="Height" Value="30" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border
					Background="#20202020"
					>
					<Rectangle
						Height="4"
						Fill="{StaticResource LightAqua_1_100}"
						/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="Slider:horizontal:pointerover /template/ RepeatButton#PART_IncreaseButton">
		<Setter Property="Height" Value="30" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border
					Background="#20202020"
					>
					<Rectangle
						Height="4"
						Fill="{StaticResource OrangePeel_0_100}"
						/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="Slider:horizontal:pressed /template/ RepeatButton#PART_IncreaseButton">
		<Setter Property="Height" Value="30" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border
					Background="#20202020"
					>
					<Rectangle
						Height="4"
						Fill="{StaticResource OrangePeel_1_100}"
						/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>



	<Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton">
		<Setter Property="Height" Value="30" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border
					Background="#20202020"
					>
					<Rectangle
						Height="4"
						Fill="{StaticResource LightAqua_1_100}"
						/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="Slider:horizontal:pointerover /template/ RepeatButton#PART_DecreaseButton">
		<Setter Property="Height" Value="30" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border
					Background="#20202020"
					>
					<Rectangle
						Height="4"
						Fill="{StaticResource OrangePeel_0_100}"
						/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="Slider:horizontal:pressed /template/ RepeatButton#PART_DecreaseButton">
		<Setter Property="Height" Value="30" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border
					Background="#20202020"
					>
					<Rectangle
						Height="4"
						Fill="{StaticResource OrangePeel_1_100}"
						/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
	
	<!-- Slider:vertical --> 
	<Style Selector="Slider:vertical /template/ Thumb">
		<Setter Property="Width" Value="14"/>
		<Setter Property="Height" Value="14"/>
		<Setter Property="Foreground" Value="{StaticResource LightAqua_1_100}" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border
					Background="{StaticResource LightAqua_1_100}"
					CornerRadius="7"
					/>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="Slider:vertical:pointerover">
		<Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
			<Setter Property="Background" Value="{StaticResource OrangePeel_0_100}" />
		</Style>
		<Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
			<Setter Property="Background" Value="{StaticResource OrangePeel_0_100}" />
		</Style>
	</Style>
	<Style Selector="Slider:vertical:pressed">
		<Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
			<Setter Property="Background" Value="{StaticResource OrangePeel_1_100}" />
		</Style>
		<Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
			<Setter Property="Background" Value="{StaticResource OrangePeel_1_100}" />
		</Style>
	</Style>
</Styles>
